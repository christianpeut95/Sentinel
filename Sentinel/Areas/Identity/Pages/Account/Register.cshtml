@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sentinel</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/Icons/sentinel-icon.svg" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style>
        :root {
            --forest:      #0C2A20;
            --forest-2:    #13382C;
            --moss:        #1E5D44;
            --signal:      #3DD598;
            --signal-dk:   #159C6E;
            --signal-lt:   #D9F2E5;
            --bone:        #F5F3EC;
            --chalk:       #FBFAF5;
            --graphite:    #4A5A55;
            --hairline:    #D8D4C4;
            --status-outbreak: #E04D2B;

            --f-sans: "Geist", ui-sans-serif, system-ui, -apple-system, sans-serif;
            --f-mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--f-sans);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            -webkit-font-smoothing: antialiased;
            font-feature-settings: "ss01", "ss02", "cv11";
        }

        /* Animated Mesh Gradient Background */
        .mesh-background {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            background: var(--forest);
        }

        .mesh-layer {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 1;
        }

        .gradient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(120px);
            animation-timing-function: ease-in-out;
            animation-iteration-count: infinite;
            animation-direction: alternate;
        }

        .orb-1 {
            width: 900px;
            height: 900px;
            background: radial-gradient(circle, #5AE4B0 0%, transparent 70%);
            top: 10%;
            left: 15%;
            animation: float-1 12s infinite;
        }

        .orb-2 {
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, #3DD598 0%, transparent 70%);
            top: 15%;
            right: 10%;
            animation: float-2 15s infinite;
        }

        .orb-3 {
            width: 1000px;
            height: 1000px;
            background: radial-gradient(circle, #3E4A48 0%, transparent 65%);
            bottom: 10%;
            right: 20%;
            animation: float-3 18s infinite;
        }

        .orb-4 {
            width: 850px;
            height: 850px;
            background: radial-gradient(circle, #1E5D44 0%, transparent 70%);
            bottom: 5%;
            left: 10%;
            animation: float-4 14s infinite;
        }

        @@keyframes float-1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(30px, -40px) scale(1.1); }
        }

        @@keyframes float-2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-40px, 30px) scale(1.15); }
        }

        @@keyframes float-3 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(25px, 35px) scale(1.08); }
        }

        @@keyframes float-4 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-30px, -25px) scale(1.12); }
        }

        .register-container {
            position: relative;
            z-index: 10;
            max-width: 520px;
            width: 100%;
            padding: 24px;
            animation: fadeInUp 0.8s ease-out;
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .register-card {
            background: var(--chalk);
            border: 1px solid var(--hairline);
            border-radius: 12px;
            padding: 48px;
            box-shadow: 0 20px 60px rgba(12, 42, 32, 0.4);
            backdrop-filter: blur(10px);
        }

        .register-header {
            text-align: center;
            margin-bottom: 36px;
        }

        .register-logo {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 24px;
        }

        .logo-icon {
            width: 56px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
            border-radius: 14px;
            box-shadow: 0 0 30px rgba(61, 213, 152, 0.3);
        }

        .logo-icon img {
            width: 56px;
            height: 56px;
        }

        .register-title {
            font-family: var(--f-sans);
            font-size: 26px;
            font-weight: 600;
            letter-spacing: -0.02em;
            color: var(--forest);
            margin-bottom: 8px;
        }

        .register-subtitle {
            font-family: var(--f-mono);
            font-size: 11px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--graphite);
        }

        .form-floating {
            margin-bottom: 20px;
        }

        .form-floating label {
            font-size: 14px;
            color: var(--graphite);
            padding: 1rem 0.75rem;
        }

        .form-control {
            border: 1px solid var(--hairline);
            border-radius: 8px;
            padding: 1rem 0.75rem;
            font-family: var(--f-sans);
            font-size: 14px;
            color: var(--forest);
            background: var(--chalk);
            transition: all 0.2s ease;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--signal-dk);
            box-shadow: 0 0 0 3px var(--signal-lt);
            background: var(--chalk);
        }

        .btn-register {
            width: 100%;
            padding: 14px;
            font-family: var(--f-sans);
            font-size: 14px;
            font-weight: 500;
            border: none;
            border-radius: 8px;
            background: var(--signal-dk);
            color: var(--chalk);
            cursor: pointer;
            transition: all 0.2s ease;
            letter-spacing: -0.005em;
        }

        .btn-register:hover {
            background: var(--moss);
            transform: translateY(-1px);
            box-shadow: 0 8px 16px rgba(12, 42, 32, 0.2);
        }

        .btn-link {
            color: var(--signal-dk);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: color 0.2s;
        }

        .btn-link:hover {
            color: var(--moss);
            text-decoration: underline;
        }

        .password-requirements {
            background: var(--bone);
            border: 1px solid var(--hairline);
            border-radius: 8px;
            padding: 14px;
            margin-bottom: 20px;
            font-size: 13px;
        }

        .password-requirements strong {
            color: var(--forest);
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
        }

        .password-requirements ul {
            margin: 0;
            padding-left: 20px;
        }

        .password-requirements li {
            color: var(--graphite);
            padding: 3px 0;
            font-size: 12px;
        }

        .alert {
            background: #FBE2D8;
            border: 1px solid #F2BBA4;
            border-radius: 8px;
            padding: 14px 16px;
            margin-bottom: 20px;
            color: #7A2A15;
            font-size: 13px;
        }

        .alert-warning {
            background: #FEF3CD;
            border-color: #FFE69C;
            color: #664D03;
        }

        .text-danger {
            color: var(--status-outbreak) !important;
            font-size: 12px;
            margin-top: 6px;
        }

        @@media (max-width: 767.98px) {
            .register-card {
                padding: 32px 24px;
            }

            .register-title {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <!-- Animated Mesh Gradient Background -->
    <div class="mesh-background">
        <div class="mesh-layer">
            <div class="gradient-orb orb-1"></div>
            <div class="gradient-orb orb-2"></div>
            <div class="gradient-orb orb-3"></div>
            <div class="gradient-orb orb-4"></div>
        </div>
    </div>

    <div class="register-container">
        <div class="register-card">
            <div class="register-header">
                <div class="register-logo">
                    <div class="logo-icon">
                        <img src="~/Icons/sentinel-icon.svg" alt="Sentinel Logo" />
                    </div>
                </div>
                <h1 class="register-title">Create Account</h1>
                <p class="register-subtitle">Disease Surveillance System</p>
            </div>

            @if (Model.RegistrationDisabled)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Registration Disabled</strong>
                    <p style="margin: 0.5rem 0 0;">Public registration has been disabled by your administrator. Please contact your system administrator to create an account.</p>
                </div>
                <div style="text-align: center; margin-top: 2rem;">
                    <a href="/Identity/Account/Login" class="btn btn-link">Back to Login</a>
                </div>
            }
            else
            {
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" />
                        <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="password-requirements mb-3">
                        <strong class="d-block mb-2"><i class="bi bi-info-circle me-2"></i>Password Requirements:</strong>
                        <ul>
                            <li>At least 6 characters long</li>
                            <li>Contains uppercase and lowercase letters</li>
                            <li>Contains at least one number</li>
                            <li>Contains at least one special character</li>
                        </ul>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn btn-register btn-primary w-100 mb-3">
                        <i class="bi bi-person-plus me-2"></i>Create Account
                    </button>

                    <div class="text-center">
                        <p class="mb-0">
                            <small>Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Sign in</a></small>
                        </p>
                    </div>
                </form>
            }
        </div>

        <div class="text-center mt-4">
            <p class="text-white mb-0">
                <small>&copy; @DateTime.Now.Year Sentinel. All rights reserved.</small>
            </p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
