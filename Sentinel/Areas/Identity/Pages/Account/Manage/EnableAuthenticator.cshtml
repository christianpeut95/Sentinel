@page
@model Sentinel.Areas.Identity.Pages.Account.Manage.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Set up two-factor authentication";
}

<link rel="stylesheet" href="~/css/identity-security.css" asp-append-version="true" />

<div class="container py-4 identity-security-page">
    <div class="identity-security-hero">
        <div class="identity-security-icon"><i class="bi bi-shield-lock"></i></div>
        <div>
            <h1 class="h3 mb-1">Set up two-factor authentication</h1>
            <p class="text-muted mb-0">Protect your Sentinel account with an authenticator app. This is optional for this installation.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="alert alert-info" role="status">@Model.StatusMessage</div>
    }

    <div class="card identity-security-card">
        <div class="card-body p-4">
            <div class="identity-security-step mb-4">
                <span class="identity-security-step-number">1</span>
                <div>
                    <h2 class="h6 mb-2">Add Sentinel to an authenticator app</h2>
                    <p class="text-muted mb-3">Scan this QR code with Microsoft Authenticator, Google Authenticator, 1Password, or another TOTP-compatible app.</p>
                    <img class="identity-security-qr" src="@Model.QrCodeImageUrl" alt="QR code for Sentinel authenticator setup" />
                </div>
            </div>

            <div class="identity-security-step mb-4">
                <span class="identity-security-step-number">2</span>
                <div>
                    <h2 class="h6 mb-2">Or enter the key manually</h2>
                    <p class="text-muted mb-2">If you cannot scan the code, enter this key in your authenticator app:</p>
                    <div class="identity-security-key border rounded bg-light p-3" aria-label="Authenticator setup key">@Model.SharedKey</div>
                </div>
            </div>

            <form method="post" class="identity-security-step">
                <span class="identity-security-step-number">3</span>
                <div class="flex-grow-1">
                    <h2 class="h6 mb-2">Confirm setup</h2>
                    <p class="text-muted">Enter the six-digit code generated by your authenticator app.</p>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-3" style="max-width: 20rem;">
                        <label asp-for="Input.Code" class="form-label"></label>
                        <input asp-for="Input.Code" class="form-control" inputmode="numeric" autocomplete="one-time-code" />
                        <span asp-validation-for="Input.Code" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Enable two-factor authentication</button>
                    <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary ms-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
