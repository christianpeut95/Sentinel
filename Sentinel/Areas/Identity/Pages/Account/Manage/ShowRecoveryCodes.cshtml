@page
@model Sentinel.Areas.Identity.Pages.Account.Manage.ShowRecoveryCodesModel
@{
    ViewData["Title"] = "Recovery codes";
}

<link rel="stylesheet" href="~/css/identity-security.css" asp-append-version="true" />

<div class="container py-4 identity-security-page">
    <div class="identity-security-hero">
        <div class="identity-security-icon"><i class="bi bi-key"></i></div>
        <div>
            <h1 class="h3 mb-1">Save your recovery codes</h1>
            <p class="text-muted mb-0">These codes are shown only once.</p>
        </div>
    </div>

    <div class="card identity-security-card">
        <div class="card-body p-4">
            <div class="alert alert-warning" role="alert">
                Save these codes now in a password manager or another secure location. Each code can be used once if you cannot access your authenticator app.
            </div>
            <div class="row row-cols-1 row-cols-sm-2 g-2 mb-4" aria-label="Recovery codes">
                @foreach (var code in Model.RecoveryCodes)
                {
                    <div class="col"><code class="d-block border rounded bg-light p-2 text-center">@code</code></div>
                }
            </div>
            <a asp-page="./TwoFactorAuthentication" class="btn btn-primary"><i class="bi bi-check2 me-1"></i>I have saved these codes</a>
        </div>
    </div>
</div>
