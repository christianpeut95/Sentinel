@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sentinel</title>

    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Geist Font -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.0.0/dist/font.css">

    <style>
        * {
            font-family: 'Geist', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1E5D44 0%, #0C2A20 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        .forgot-password-container {
            width: 100%;
            max-width: 480px;
        }

        .logo-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .logo {
            width: 72px;
            height: 72px;
            background: #3DD598;
            border-radius: 16px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            box-shadow: 0 8px 24px rgba(61, 213, 152, 0.2);
        }

        .logo i {
            font-size: 36px;
            color: #0C2A20;
        }

        .logo-text {
            font-size: 28px;
            font-weight: 600;
            color: #F5F3EC;
            letter-spacing: -0.02em;
        }

        .card {
            background: #FBFAF5;
            border: 1px solid rgba(216, 212, 196, 0.3);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
        }

        .card-body {
            padding: 2.5rem;
        }

        h2 {
            color: #0C2A20;
            font-weight: 600;
            font-size: 24px;
            margin-bottom: 0.5rem;
            letter-spacing: -0.02em;
        }

        .subtitle {
            color: #6B7A78;
            font-size: 15px;
            margin-bottom: 2rem;
        }

        .form-label {
            color: #4A5A55;
            font-weight: 500;
            font-size: 14px;
            margin-bottom: 0.5rem;
        }

        .form-control {
            background: #FFFFFF;
            border: 1px solid #D8D4C4;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            color: #0C2A20;
            transition: all 0.2s;
        }

        .form-control:focus {
            border-color: #159C6E;
            box-shadow: 0 0 0 3px rgba(21, 156, 110, 0.1);
            outline: none;
            background: #FFFFFF;
        }

        .btn-primary {
            background: linear-gradient(135deg, #3DD598 0%, #159C6E 100%);
            border: none;
            color: #0C2A20;
            font-weight: 500;
            padding: 0.875rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s;
            box-shadow: 0 4px 12px rgba(21, 156, 110, 0.2);
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #159C6E 0%, #0F7D57 100%);
            color: #F5F3EC;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(21, 156, 110, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .btn-secondary {
            background: #ECEAE1;
            border: 1px solid #D8D4C4;
            color: #4A5A55;
            font-weight: 500;
            padding: 0.875rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .btn-secondary:hover {
            background: #E0DED3;
            border-color: #C8C4B4;
            color: #2A3A35;
        }

        .alert {
            border-radius: 8px;
            border: none;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

        .alert-success {
            background: #E8F5F0;
            color: #0F7D57;
            border-left: 4px solid #159C6E;
        }

        .alert-danger {
            background: #FEE;
            color: #A02020;
            border-left: 4px solid #DC3545;
        }

        .text-muted {
            color: #6B7A78 !important;
        }

        .info-box {
            background: #F0F7F4;
            border-left: 4px solid #3DD598;
            padding: 1rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }

        .info-box i {
            color: #159C6E;
            font-size: 20px;
            margin-right: 0.5rem;
        }

        .info-box p {
            margin: 0;
            color: #4A5A55;
            font-size: 14px;
        }

        @@media (max-width: 576px) {
            .card-body {
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="forgot-password-container">
        <div class="logo-section">
            <div class="logo">
                <i class="bi bi-shield-fill-check"></i>
            </div>
            <div class="logo-text">Sentinel</div>
        </div>

        <div class="card">
            <div class="card-body">
                <h2>Forgot Password?</h2>
                <p class="subtitle">No worries! Enter your email and we'll send you reset instructions.</p>

                @if (Model.EmailSent)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <strong>Email Sent!</strong> If an account exists with that email, you'll receive password reset instructions shortly.
                    </div>
                    <div class="info-box">
                        <i class="bi bi-info-circle-fill"></i>
                        <p>
                            <strong>Check your email</strong> for a password reset link (it may take a few minutes). 
                            If you don't receive it, check your spam folder.
                        </p>
                    </div>
                    <a asp-page="./Login" class="btn btn-secondary w-100">
                        <i class="bi bi-arrow-left me-2"></i>Back to Login
                    </a>
                }
                else
                {
                    <form method="post">
                        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Input.Email" class="form-label">Email Address</label>
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" 
                                   aria-required="true" placeholder="you@example.com" autofocus />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="info-box">
                            <i class="bi bi-info-circle-fill"></i>
                            <p>
                                You'll receive an email with a secure link to reset your password. 
                                The link will expire in 24 hours.
                            </p>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mb-3">
                            <i class="bi bi-envelope me-2"></i>Send Reset Link
                        </button>

                        <a asp-page="./Login" class="btn btn-secondary w-100">
                            <i class="bi bi-arrow-left me-2"></i>Back to Login
                        </a>
                    </form>
                }
            </div>
        </div>

        <div class="text-center mt-3">
            <small class="text-muted">
                Remember your password? <a asp-page="./Login" style="color: #3DD598; text-decoration: none;">Sign in</a>
            </small>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>
