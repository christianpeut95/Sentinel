@page "/settings/backups"
@layout Components.Layout.SentinelLayout
@rendermode RenderMode.InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Sentinel.Services
@attribute [Authorize]

<PageTitle>Database Backups - Sentinel</PageTitle>

<div class="sentinel-container py-4">
    <!-- Page Header -->
    <div class="sentinel-card-header mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="sentinel-card-title mb-2">
                    <i class="bi bi-hdd-stack me-2"></i>
                    Database Backups
                </h1>
                <p class="sentinel-card-subtitle text-muted mb-0">
                    Create, restore, and manage automated database backups
                </p>
            </div>
            <div>
                <button class="btn-sentinel-primary" @onclick="CreateBackup" disabled="@(!BackupService.IsBackupConfigured || isCreatingBackup)">
                    @if (isCreatingBackup)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Creating Backup...</span>
                    }
                    else
                    {
                        <i class="bi bi-plus-circle me-2"></i>
                        <span>Create Backup</span>
                    }
                </button>
            </div>
        </div>
    </div>

    @if (!BackupService.IsBackupConfigured)
    {
        <div class="sentinel-card mb-4" style="border-left: 4px solid var(--status-outbreak);">
            <div class="d-flex align-items-center gap-3">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                <div>
                    <strong>Backups need administrator configuration.</strong>
                    <div class="text-meta">@(BackupService.BackupConfigurationIssue ?? "Configure a dedicated database backup account before creating backups.")</div>
                </div>
            </div>
        </div>
    }

    <!-- Backup Configuration Section -->
    <div class="sentinel-card mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="text-h3 mb-0">
                <i class="bi bi-gear me-2"></i>
                Backup Configuration
            </h5>
            <button class="btn btn-link btn-sm p-0" @onclick="ToggleConfigSection">
                <i class="bi @(showConfigSection ? "bi-chevron-up" : "bi-chevron-down")"></i>
            </button>
        </div>

        @if (showConfigSection)
        {
            <div class="border-top pt-3" style="border-color: var(--hairline) !important;">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="sentinel-label">Backup Directory Path</label>
                        <div class="input-group">
                            <input type="text" 
                                   class="sentinel-input" 
                                   @bind="configuredBackupPath" 
                                   placeholder="Leave empty for default: C:\DatabaseBackups\SurveillanceMVP"
                                   style="border-radius: var(--radius-sm) 0 0 var(--radius-sm);" />
                            <button class="btn-sentinel-secondary" 
                                    @onclick="UseDefaultPath"
                                    style="border-radius: 0; border-left: none;">
                                Use Default
                            </button>
                        </div>
                        <small class="text-meta d-block mt-2">
                            <i class="bi bi-info-circle me-1"></i>
                            Current path: <span class="text-mono">@currentBackupPath</span>
                        </small>
                    </div>

                    <div class="col-12">
                        <button class="btn-sentinel-primary" 
                                @onclick="SaveConfiguration" 
                                disabled="@isSavingConfig">
                            @if (isSavingConfig)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-2"></i>
                                <span>Save Configuration</span>
                            }
                        </button>
                        <button class="btn-sentinel-secondary ms-2" 
                                @onclick="CancelConfiguration" 
                                disabled="@isSavingConfig">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="sentinel-card mb-4" style="@(statusIsError ? "border-left: 4px solid var(--status-outbreak);" : "border-left: 4px solid var(--signal-dk);")">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi @(statusIsError ? "bi-exclamation-triangle-fill text-danger" : "bi-check-circle-fill text-success") fs-4"></i>
                    <span>@statusMessage</span>
                </div>
                <button type="button" class="btn-close" @onclick="ClearStatus" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Backup History Table -->
    <div class="sentinel-card">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="text-muted mt-3">Loading backup history...</p>
            </div>
        }
        else if (backups == null || !backups.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-4 text-muted"></i>
                <p class="text-muted mt-3">No backups found. Create your first backup to get started.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: var(--paper); border-bottom: 2px solid var(--hairline);">
                        <tr>
                            <th class="text-label" style="padding: 12px;">File Name</th>
                            <th class="text-label" style="padding: 12px;">Type</th>
                            <th class="text-label" style="padding: 12px;">Size</th>
                            <th class="text-label" style="padding: 12px;">Created</th>
                            <th class="text-label" style="padding: 12px;">Duration</th>
                            <th class="text-label" style="padding: 12px;">Status</th>
                            <th class="text-label" style="padding: 12px;">Created By</th>
                            <th class="text-label text-end" style="padding: 12px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var backup in backups)
                        {
                            <tr style="border-bottom: 1px solid var(--hairline);">
                                <td style="padding: 14px;">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (backup.FileExists)
                                        {
                                            <i class="bi bi-file-earmark-zip" style="color: var(--signal-dk);"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-file-earmark-x" style="color: var(--status-outbreak);"></i>
                                        }
                                        <span class="text-mono">@backup.BackupFileName</span>
                                    </div>
                                </td>
                                <td style="padding: 14px;">
                                    <span class="chip chip-info">
                                        <span class="dot"></span>
                                        @backup.BackupType
                                    </span>
                                </td>
                                <td style="padding: 14px;">
                                    <span class="text-mono">@backup.SizeInMB.ToString("F2") MB</span>
                                </td>
                                <td style="padding: 14px;">
                                    <div class="text-meta">
                                        <div>@backup.StartTime.ToString("MMM dd, yyyy")</div>
                                        <div style="color: var(--graphite);">@backup.StartTime.ToString("h:mm tt")</div>
                                    </div>
                                </td>
                                <td style="padding: 14px;">
                                    <span class="text-meta">@FormatDuration(backup.Duration)</span>
                                </td>
                                <td style="padding: 14px;">
                                    @if (backup.Success)
                                    {
                                        <span class="chip chip-clear">
                                            <span class="dot"></span>
                                            Success
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="chip chip-outbreak" title="@backup.ErrorMessage">
                                            <span class="dot"></span>
                                            Failed
                                        </span>
                                    }
                                </td>
                                <td style="padding: 14px;">
                                    <span class="text-meta">@(backup.CreatedBy ?? "System")</span>
                                </td>
                                <td class="text-end" style="padding: 14px;">
                                    <div class="btn-group btn-group-sm" role="group">
                                        @if (backup.FileExists && backup.Success)
                                        {
                                            <button class="btn btn-outline-primary btn-sm" 
                                                    @onclick="() => ShowRestoreConfirmation(backup)"
                                                    disabled="@(!BackupService.IsRestoreConfigured || isProcessing)"
                                                    title="@(BackupService.IsRestoreConfigured ? "Restore from this backup" : "Restore requires a separately configured administrator connection")">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                        <button class="btn btn-outline-danger btn-sm" 
                                                @onclick="() => ShowDeleteConfirmation(backup)"
                                                disabled="@isProcessing"
                                                title="Delete this backup">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (backups.Count >= 50)
            {
                <div class="sentinel-card mt-3" style="background: var(--signal-lt); border-color: var(--signal-dk);">
                    <i class="bi bi-info-circle me-2"></i>
                    <span class="text-meta">Showing the 50 most recent backups</span>
                </div>
            }
        }
    </div>
</div>

@* Restore Confirmation Modal *@
@if (showRestoreModal && backupToRestore != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(12, 42, 32, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sentinel-card" style="border: 1px solid var(--hairline); box-shadow: var(--shadow-lg);">
                <div class="modal-header" style="border-bottom: 1px solid var(--hairline); padding: 24px;">
                    <h5 class="modal-title sentinel-card-title" style="font-size: 20px;">
                        <i class="bi bi-exclamation-triangle-fill me-2" style="color: var(--status-watch);"></i>
                        Confirm Database Restore
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseRestoreModal" disabled="@isProcessing"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <div class="sentinel-card mb-3" style="background: var(--paper); border-left: 4px solid var(--status-watch);">
                        <strong>Warning:</strong> This operation will:
                        <ul class="mb-0 mt-2">
                            <li>Disconnect all active users</li>
                            <li>Replace the current database with the backup</li>
                            <li>All data created after <strong>@backupToRestore.StartTime.ToString("MMM dd, yyyy h:mm tt")</strong> will be lost</li>
                        </ul>
                    </div>
                    <div class="text-meta mb-2"><strong>Backup File:</strong></div>
                    <p class="text-mono mb-3" style="color: var(--graphite);">@backupToRestore.BackupFileName</p>
                    <div class="text-meta mb-2"><strong>Backup Size:</strong> @backupToRestore.SizeInMB.ToString("F2") MB</div>
                    <div class="text-meta mb-0"><strong>Created:</strong> @backupToRestore.StartTime.ToString("MMM dd, yyyy h:mm tt")</div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--hairline); padding: 20px 24px; gap: 12px;">
                    <button type="button" class="btn-sentinel-secondary" @onclick="CloseRestoreModal" disabled="@isProcessing">
                        Cancel
                    </button>
                    <button type="button" class="btn-sentinel-danger" @onclick="ConfirmRestore" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Restoring...</span>
                        }
                        else
                        {
                            <i class="bi bi-arrow-counterclockwise me-2"></i>
                            <span>Restore Database</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Delete Confirmation Modal *@
@if (showDeleteModal && backupToDelete != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(12, 42, 32, 0.75);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content sentinel-card" style="border: 1px solid var(--hairline); box-shadow: var(--shadow-lg);">
                <div class="modal-header" style="border-bottom: 1px solid var(--hairline); padding: 24px;">
                    <h5 class="modal-title sentinel-card-title" style="font-size: 20px;">
                        <i class="bi bi-trash me-2" style="color: var(--status-outbreak);"></i>
                        Confirm Backup Deletion
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseDeleteModal" disabled="@isProcessing"></button>
                </div>
                <div class="modal-body" style="padding: 24px;">
                    <p class="text-body mb-3">Are you sure you want to delete this backup?</p>
                    <div class="text-meta mb-2"><strong>File:</strong></div>
                    <p class="text-mono mb-3" style="color: var(--graphite);">@backupToDelete.BackupFileName</p>
                    <div class="text-meta mb-2"><strong>Size:</strong> @backupToDelete.SizeInMB.ToString("F2") MB</div>
                    <div class="text-meta mb-3"><strong>Created:</strong> @backupToDelete.StartTime.ToString("MMM dd, yyyy h:mm tt")</div>
                    @if (!backupToDelete.FileExists)
                    {
                        <div class="sentinel-card" style="background: var(--signal-lt); border-color: var(--signal-dk);">
                            <i class="bi bi-info-circle me-2"></i>
                            <span class="text-meta">Note: The backup file no longer exists. This will only remove the history record.</span>
                        </div>
                    }
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--hairline); padding: 20px 24px; gap: 12px;">
                    <button type="button" class="btn-sentinel-secondary" @onclick="CloseDeleteModal" disabled="@isProcessing">
                        Cancel
                    </button>
                    <button type="button" class="btn-sentinel-danger" @onclick="ConfirmDelete" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Deleting...</span>
                        }
                        else
                        {
                            <i class="bi bi-trash me-2"></i>
                            <span>Delete Backup</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
