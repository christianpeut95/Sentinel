@using Sentinel.Services.HL7
@using Sentinel.Models
@using Sentinel.Data
@using Microsoft.EntityFrameworkCore
@inject IHL7ParserService ParserService
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILogger<UploadSampleStage> Logger

<div class="wizard-stage">
    <!-- Progress Header -->
    <div class="wizard-progress">
        <div class="progress-step active">
            <div class="step-number">1</div>
            <div class="step-label">Upload Sample</div>
        </div>
        <div class="progress-connector"></div>
        <div class="progress-step">
            <div class="step-number">2</div>
            <div class="step-label">Review Mappings</div>
        </div>
        <div class="progress-connector"></div>
        <div class="progress-step">
            <div class="step-number">3</div>
            <div class="step-label">Test & Activate</div>
        </div>
    </div>

    <!-- Stage Content -->
    <div class="stage-content">
        <div class="stage-hero">
            <div class="hero-icon">
                <i class="bi bi-file-earmark-medical"></i>
            </div>
            <h2 class="hero-title">Upload a Sample HL7 Message</h2>
            <p class="hero-description">
                Paste a real HL7 message from <strong>@ConfigurationName</strong>. 
                Sentinel will analyze it and learn how to read messages from this lab.
            </p>
            <div class="hero-callout">
                <i class="bi bi-shield-check"></i>
                <span>This is safe — no cases will be created from this sample</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@ErrorMessage
            </div>
        }

        <div class="upload-area">
            <label class="form-label">Paste HL7 message</label>
            <textarea 
                class="hl7-textarea" 
                @bind="MessageContent"
                placeholder="MSH|^~\&|LAB||SENTINEL||20240315103052||ORU^R01|MSG001|P|2.5&#10;PID|1||MRN123456||SMITH^JANE^M||19850422|F|||123 Main St^^Wellington^^6011||...&#10;OBR|1||LAB123456|87881^Salmonella Culture|||20240315100000&#10;OBX|1|ST|87881^Salmonella Culture||Positive||||||F"
                rows="12"></textarea>
            <div class="form-help">
                Paste the entire message including the MSH segment
            </div>
        </div>

        <div class="stage-actions">
            <button class="btn-wizard btn-primary" @onclick="AnalyzeMessage" disabled="@IsAnalyzing">
                @if (IsAnalyzing)
                {
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    <span>Analyzing...</span>
                }
                else
                {
                    <i class="bi bi-cpu me-2"></i>
                    <span>Analyze Message</span>
                }
            </button>
        </div>

        <!-- Tips Section -->
        <div class="tips-section">
            <div class="tip-header">
                <i class="bi bi-lightbulb"></i>
                <span>Tips for best results</span>
            </div>
            <ul class="tip-list">
                <li>Use a complete, real message from this lab (not test data)</li>
                <li>Include all segments (MSH, PID, OBR, OBX, etc.)</li>
                <li>Choose a positive result if possible — it will have more data</li>
                <li>Make sure patient information is complete</li>
            </ul>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid ConfigurationId { get; set; }
    [Parameter] public string ConfigurationName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnSampleUploaded { get; set; }

    private string MessageContent { get; set; } = string.Empty;
    private string? ErrorMessage { get; set; }
    private bool IsAnalyzing { get; set; }

    private async Task AnalyzeMessage()
    {
        ErrorMessage = null;

        if (string.IsNullOrWhiteSpace(MessageContent))
        {
            ErrorMessage = "Please paste an HL7 message to analyze.";
            return;
        }

        IsAnalyzing = true;
        StateHasChanged();

        try
        {
            // Validate the message
            var validation = await ParserService.ValidateMessageAsync(MessageContent);
            if (!validation.IsValid)
            {
                ErrorMessage = $"Could not parse message: {string.Join(", ", validation.Errors)}";
                return;
            }

            // Store the sample message
            await using var context = await DbContextFactory.CreateDbContextAsync();

            var mapping = await context.HL7FieldMappings
                .Where(m => m.ConfigurationId == ConfigurationId)
                .FirstOrDefaultAsync()
                ?? new HL7FieldMapping
                {
                    Id = Guid.NewGuid(),
                    ConfigurationId = ConfigurationId,
                    SegmentType = "SAMPLE",
                    FieldPath = "SAMPLE",
                    TargetEntity = "Configuration",
                    TargetProperty = "SampleMessage",
                    FieldName = "Sample HL7 Message",
                    CreatedAt = DateTime.UtcNow
                };

            mapping.SampleMessage = MessageContent;
            mapping.ModifiedAt = DateTime.UtcNow;

            if (mapping.CreatedAt == default)
            {
                context.HL7FieldMappings.Add(mapping);
            }

            await context.SaveChangesAsync();

            Logger.LogInformation("Sample message saved for configuration {ConfigId}", ConfigurationId);

            // Notify parent
            await OnSampleUploaded.InvokeAsync(MessageContent);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error analyzing message");
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            IsAnalyzing = false;
            StateHasChanged();
        }
    }
}

