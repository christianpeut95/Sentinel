    private async Task ConfirmField()
    {
        var field = Fields[CurrentFieldIndex];

        try
        {
            Logger.LogWarning("========== CONFIRMFIELD CALLED ==========");
            Logger.LogWarning("ConfirmField: Field {FieldName} ({Entity}.{Property})", 
                field.FriendlyName, field.TargetEntity, field.TargetProperty);
            Logger.LogWarning("ConfirmField: SelectedCandidateValue = '{Value}'", SelectedCandidateValue ?? "NULL");
            Logger.LogWarning("ConfirmField: SelectedCandidateFieldPath = '{Path}'", SelectedCandidateFieldPath ?? "NULL");
            Logger.LogWarning("ConfirmField: ConfigurationId = {ConfigId}", ConfigurationId);

            // Create a new DbContext instance for this operation
            await using var context = await DbContextFactory.CreateDbContextAsync();
            Logger.LogWarning("ConfirmField: DbContext created successfully");

            // Save the mapping - use proper upsert pattern
            var key = $"{field.TargetEntity}_{field.TargetProperty}";

            // Check if mapping exists in database
            var existingMapping = await context.HL7FieldMappings
                .Where(m => m.ConfigurationId == ConfigurationId && 
                           m.TargetEntity == field.TargetEntity && 
                           m.TargetProperty == field.TargetProperty)
                .FirstOrDefaultAsync();

            bool isNew = existingMapping == null;

            if (isNew)
            {
                // Create new mapping
                var newMapping = new HL7FieldMapping
                {
                    Id = Guid.NewGuid(),
                    ConfigurationId = ConfigurationId,
                    TargetEntity = field.TargetEntity,
                    TargetProperty = field.TargetProperty,
                    FieldName = field.FriendlyName,
                    IsRequired = field.IsRequired,
                    FieldPath = SelectedCandidateFieldPath ?? "MANUAL",
                    SegmentType = ExtractSegmentType(SelectedCandidateFieldPath ?? "MANUAL"),
                    IsActive = true,
                    CreatedAt = DateTime.UtcNow,
                    ModifiedAt = DateTime.UtcNow
                };
                context.HL7FieldMappings.Add(newMapping);
                Logger.LogWarning("ConfirmField: ADDED new mapping to context, ID = {MappingId}", newMapping.Id);
            }
            else
            {
                // Update existing mapping
                existingMapping.FieldPath = SelectedCandidateFieldPath ?? "MANUAL";
                existingMapping.SegmentType = ExtractSegmentType(existingMapping.FieldPath);
                existingMapping.IsActive = true;
                existingMapping.ModifiedAt = DateTime.UtcNow;
                // Entity is already tracked, no need to call Update
                Logger.LogWarning("ConfirmField: UPDATED existing mapping in context, ID = {MappingId}", existingMapping.Id);
            }

            var savedCount = await context.SaveChangesAsync();
            Logger.LogWarning("ConfirmField: SaveChangesAsync returned {SavedCount}", savedCount);
            Logger.LogWarning("ConfirmField: ✅ SUCCESS - Saved {FieldName} → {FieldPath}", 
                field.FriendlyName, SelectedCandidateFieldPath ?? "MANUAL");

            // Track confirmed mapping for preview (store both value and path)
            if (!string.IsNullOrEmpty(SelectedCandidateValue) && !string.IsNullOrEmpty(SelectedCandidateFieldPath))
            {
                ConfirmedMappings[key] = (SelectedCandidateValue, SelectedCandidateFieldPath);
            }

            // Move to next field or complete
            if (CurrentFieldIndex < Fields.Count - 1)
            {
                CurrentFieldIndex++;
                // Load any existing mapping for the new current field
                LoadSavedSelectionForCurrentField();
                StateHasChanged();
            }
            else
            {
                Logger.LogWarning("ConfirmField: All fields confirmed, moving to next stage");
                await OnAllFieldsConfirmed.InvokeAsync();
            }
            Logger.LogWarning("========== CONFIRMFIELD COMPLETE ==========");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "❌ ConfirmField: ERROR confirming field {FieldName}", field.FriendlyName);
            throw;
        }
    }

    private async Task SkipField()
    {
        var field = Fields[CurrentFieldIndex];

        try
        {
            await using var context = await DbContextFactory.CreateDbContextAsync();

            // Save as skipped - use proper upsert pattern
            var existingMapping = await context.HL7FieldMappings
                .Where(m => m.ConfigurationId == ConfigurationId && 
                           m.TargetEntity == field.TargetEntity && 
                           m.TargetProperty == field.TargetProperty)
                .FirstOrDefaultAsync();

            bool isNew = existingMapping == null;

            if (isNew)
            {
                // Create new mapping for skipped field
                var newMapping = new HL7FieldMapping
                {
                    Id = Guid.NewGuid(),
                    ConfigurationId = ConfigurationId,
                    TargetEntity = field.TargetEntity,
                    TargetProperty = field.TargetProperty,
                    FieldName = field.FriendlyName,
                    FieldPath = "SKIPPED",
                    SegmentType = "SKIPPED",
                    IsActive = false,
                    CreatedAt = DateTime.UtcNow,
                    ModifiedAt = DateTime.UtcNow
                };
                context.HL7FieldMappings.Add(newMapping);
                Logger.LogWarning("SkipField: ADDED new skipped mapping to context, ID = {MappingId}", newMapping.Id);
            }
            else
            {
                // Update existing mapping to mark as skipped
                existingMapping.FieldPath = "SKIPPED";
                existingMapping.SegmentType = "SKIPPED";
                existingMapping.IsActive = false;
                existingMapping.ModifiedAt = DateTime.UtcNow;
                // Entity is already tracked, no need to call Update
                Logger.LogWarning("SkipField: UPDATED existing mapping to SKIPPED, ID = {MappingId}", existingMapping.Id);
            }

            var savedCount = await context.SaveChangesAsync();
            Logger.LogWarning("SkipField: SaveChangesAsync returned {SavedCount}", savedCount);
            Logger.LogWarning("SkipField: ✅ SUCCESS - Skipped {FieldName}", field.FriendlyName);

            // Move to next
            if (CurrentFieldIndex < Fields.Count - 1)
            {
                CurrentFieldIndex++;
                // Load any existing mapping for the new current field
                LoadSavedSelectionForCurrentField();
                StateHasChanged();
            }
            else
            {
                await OnAllFieldsConfirmed.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error skipping field {FieldName}", field.FriendlyName);
            throw;
        }
    }

    private void PreviousField()
    {
        if (CurrentFieldIndex > 0)
        {
            CurrentFieldIndex--;
            LoadSavedSelectionForCurrentField();
            StateHasChanged();
        }
    }

    private void JumpToField(int fieldIndex)
    {
        if (fieldIndex >= 0 && fieldIndex < Fields.Count)
        {
            CurrentFieldIndex = fieldIndex;
            LoadSavedSelectionForCurrentField();
            StateHasChanged();
        }
    }

    private bool IsMultiObservationField(FieldToReview field)
    {
        if (ParsedResultData == null || ParsedResultData.Count <= 1)
            return false;

        // Check if this field is observation-related
        var observationFields = new[] { "biomarker", "test_result", "test_type", "loinc_code" };
        return observationFields.Contains(field.TargetProperty);
    }

    private void LoadSavedSelectionForCurrentField()
    {
        var field = Fields[CurrentFieldIndex];
        var key = $"{field.TargetEntity}_{field.TargetProperty}";

        // Check if this field has a confirmed mapping
        if (ConfirmedMappings.TryGetValue(key, out var savedMapping))
        {
            SelectedCandidateValue = savedMapping.Value;
            SelectedCandidateFieldPath = savedMapping.Path;
        }
        else
        {
            SelectedCandidateValue = null;
            SelectedCandidateFieldPath = null;
        }
    }

