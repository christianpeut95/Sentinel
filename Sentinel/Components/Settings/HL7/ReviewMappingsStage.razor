    private List<ParsedField> ExtractAllFields(HL7ParseResult parseResult)
    {
        var fields = new List<ParsedField>();

        // Extract from PatientData
        foreach (var kvp in parseResult.PatientData)
        {
            if (!string.IsNullOrWhiteSpace(kvp.Value))
            {
                fields.Add(new ParsedField { Path = $"PID.{kvp.Key}", Value = kvp.Value });
            }
        }

        // Extract from OrderData
        foreach (var kvp in parseResult.OrderData)
        {
            if (!string.IsNullOrWhiteSpace(kvp.Value))
            {
                fields.Add(new ParsedField { Path = $"OBR.{kvp.Key}", Value = kvp.Value });
            }
        }

        // Extract from SpecimenData
        foreach (var kvp in parseResult.SpecimenData)
        {
            if (!string.IsNullOrWhiteSpace(kvp.Value))
            {
                fields.Add(new ParsedField { Path = $"SPM.{kvp.Key}", Value = kvp.Value });
            }
        }

        // Extract from ResultData (OBX segments)
        // Group by field key to show normalized paths (OBX.Field instead of OBX[1].Field)
        // and collect all values from all observations
        var obxFieldGroups = new Dictionary<string, List<string>>();

        foreach (var result in parseResult.ResultData)
        {
            foreach (var kvp in result)
            {
                if (!string.IsNullOrWhiteSpace(kvp.Value))
                {
                    if (!obxFieldGroups.ContainsKey(kvp.Key))
                    {
                        obxFieldGroups[kvp.Key] = new List<string>();
                    }
                    obxFieldGroups[kvp.Key].Add(kvp.Value);
                }
            }
        }

        // Add normalized OBX fields with all values collected
        foreach (var kvp in obxFieldGroups)
        {
            var normalizedPath = $"OBX.{kvp.Key}";
            var allValues = kvp.Value;

            // Store the first value as the primary value, but keep all values for display
            fields.Add(new ParsedField 
            { 
                Path = normalizedPath, 
                Value = allValues.First(),
                AllValues = allValues // Store all observation values
            });
        }

        Logger.LogInformation("Extracted {Count} fields from parse result ({OBXFields} unique OBX fields from {ObsCount} observations)", 
            fields.Count, 
            obxFieldGroups.Count,
            parseResult.ResultData.Count);

        return fields;
    }

    private string ExtractSegmentType(string fieldPath)
    {
        if (string.IsNullOrEmpty(fieldPath) || fieldPath == "SKIPPED" || fieldPath == "MANUAL")
            return fieldPath;

        var parts = fieldPath.Split('-');
        return parts.Length > 0 ? parts[0] : "UNKNOWN";
    }

    // Field detection logic (similar to original ConfigureLab)
    private async Task<List<CandidateValue>> DetectCandidatesAsync(HL7ParseResult parseResult, FieldDefinition fieldDef)
    {
        var candidates = new List<CandidateValue>();

        switch (fieldDef.Key)
        {
            case "patient_firstname":
                if (parseResult.PatientData.TryGetValue("FirstName", out var firstName) && !string.IsNullOrEmpty(firstName))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = firstName,
                        DisplayValue = firstName,
                        Hint = "Found in patient name",
                        FieldPath = "PID-5.2",
                        Confidence = 90
                    });
                }
                break;

            case "patient_lastname":
                if (parseResult.PatientData.TryGetValue("LastName", out var lastName) && !string.IsNullOrEmpty(lastName))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = lastName,
                        DisplayValue = lastName,
                        Hint = "Found in patient name",
                        FieldPath = "PID-5.1",
                        Confidence = 90
                    });
                }
                break;

            case "patient_dob":
                if (parseResult.PatientData.TryGetValue("DateOfBirth", out var dob) && !string.IsNullOrEmpty(dob))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = dob,
                        DisplayValue = FormatDate(dob),
                        Hint = "Found in patient demographics",
                        FieldPath = "PID-7",
                        Confidence = 95
                    });
                }
                break;

            case "patient_sex":
                if (parseResult.PatientData.TryGetValue("Sex", out var sex) && !string.IsNullOrEmpty(sex))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = sex,
                        DisplayValue = sex,
                        Hint = "Found in patient sex field",
                        FieldPath = "PID-8",
                        Confidence = 95
                    });
                }
                break;

            case "patient_address":
                if (parseResult.PatientData.TryGetValue("Address", out var address) && !string.IsNullOrEmpty(address))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = address,
                        DisplayValue = address,
                        Hint = "Found in patient address field",
                        FieldPath = "PID-11.1",
                        Confidence = 85
                    });
                }
                break;

            case "patient_suburb":
                if (parseResult.PatientData.TryGetValue("City", out var city) && !string.IsNullOrEmpty(city))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = city,
                        DisplayValue = city,
                        Hint = "Found in patient address",
                        FieldPath = "PID-11.3",
                        Confidence = 85
                    });
                }
                break;

            case "patient_state":
                if (parseResult.PatientData.TryGetValue("State", out var state) && !string.IsNullOrEmpty(state))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = state,
                        DisplayValue = state,
                        Hint = "Found in patient address",
                        FieldPath = "PID-11.4",
                        Confidence = 85
                    });
                }
                break;

            case "patient_postcode":
                if (parseResult.PatientData.TryGetValue("ZipCode", out var zip) && !string.IsNullOrEmpty(zip))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = zip,
                        DisplayValue = zip,
                        Hint = "Found in patient address",
                        FieldPath = "PID-11.5",
                        Confidence = 85
                    });
                }
                break;

            case "patient_phone":
                if (parseResult.PatientData.TryGetValue("Phone", out var phone) && !string.IsNullOrEmpty(phone))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = phone,
                        DisplayValue = phone,
                        Hint = "Found in patient phone number",
                        FieldPath = "PID-13",
                        Confidence = 90
                    });
                }
                break;

            case "accession_number":
                if (parseResult.OrderData.TryGetValue("AccessionNumber", out var accession) && !string.IsNullOrEmpty(accession))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = accession,
                        DisplayValue = accession,
                        Hint = "Found in order information",
                        FieldPath = "OBR-3",
                        Confidence = 95
                    });
                }
                break;

            case "ordering_provider":
                if (parseResult.OrderData.TryGetValue("OrderingProvider", out var provider) && !string.IsNullOrEmpty(provider))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = provider,
                        DisplayValue = provider,
                        Hint = "Found in order information",
                        FieldPath = "OBR-16",
                        Confidence = 90
                    });
                }
                break;

            case "test_type":
                // First check for test method from OBX segments (per-observation test method)
                if (parseResult.ResultData.Any())
                {
                    var testMethods = new List<string>();

                    foreach (var result in parseResult.ResultData)
                    {
                        if (result.TryGetValue("TestMethod", out var method) && !string.IsNullOrEmpty(method))
                        {
                            testMethods.Add(method);
                        }
                    }

                    if (testMethods.Any())
                    {
                        var isMultiObservation = testMethods.Count > 1;
                        var uniqueMethods = testMethods.Distinct().ToList();

                        var displayValue = isMultiObservation && uniqueMethods.Count > 1
                            ? $"{testMethods.Count} methods: {string.Join(", ", uniqueMethods.Take(3))}{(uniqueMethods.Count > 3 ? "..." : "")}"
                            : testMethods[0];

                        var hint = isMultiObservation
                            ? $"Found {testMethods.Count} test methods in OBX-17 (applies to all observations)"
                            : "Found in observation method (OBX-17)";

                        candidates.Add(new CandidateValue
                        {
                            Value = string.Join("|", testMethods),
                            DisplayValue = displayValue,
                            Hint = hint,
                            FieldPath = "OBX-17",
                            Confidence = 95
                        });
                    }
                }

                // Fallback to order-level test name (OBR-4)
                if (parseResult.OrderData.TryGetValue("TestName", out var testName) && !string.IsNullOrEmpty(testName))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = testName,
                        DisplayValue = testName,
                        Hint = "Found in order test name (OBR-4.2)",
                        FieldPath = "OBR-4.2",
                        Confidence = 75
                    });
                }
                if (parseResult.OrderData.TryGetValue("TestCode", out var testCode) && !string.IsNullOrEmpty(testCode))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = testCode,
                        DisplayValue = $"{testCode} (code)",
                        Hint = "Found as order test code (OBR-4.1)",
                        FieldPath = "OBR-4.1",
                        Confidence = 70
                    });
                }
                break;

            case "test_result":
                if (parseResult.ResultData.Any())
                {
                    // Collect all unique result values from observations
                    var resultValues = new List<string>();

                    foreach (var result in parseResult.ResultData)
                    {
                        if (result.TryGetValue("Result", out var resultValue) && !string.IsNullOrEmpty(resultValue))
                        {
                            resultValues.Add(resultValue);
                        }
                    }

                    if (resultValues.Any())
                    {
                        var isMultiObservation = resultValues.Count > 1;
                        var uniqueResults = resultValues.Distinct().ToList();

                        var displayValue = isMultiObservation
                            ? $"{resultValues.Count} results: {string.Join(", ", uniqueResults.Take(3))}{(uniqueResults.Count > 3 ? "..." : "")}"
                            : resultValues[0];

                        var hint = isMultiObservation
                            ? $"Found {resultValues.Count} results in OBX-5 (applies to all observations)"
                            : "Found in observation result (OBX-5)";

                        candidates.Add(new CandidateValue
                        {
                            Value = string.Join("|", resultValues),
                            DisplayValue = displayValue,
                            Hint = hint,
                            FieldPath = "OBX-5",
                            Confidence = 90
                        });
                    }
                }
                break;

            case "test_date":
                if (parseResult.OrderData.TryGetValue("OrderDateTime", out var testDate) && !string.IsNullOrEmpty(testDate))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = testDate,
                        DisplayValue = FormatDate(testDate),
                        Hint = "Found in order date/time",
                        FieldPath = "OBR-7",
                        Confidence = 90
                    });
                }
                break;

            case "specimen_type":
                if (parseResult.SpecimenData.TryGetValue("SpecimenType", out var specimenType) && !string.IsNullOrEmpty(specimenType))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = specimenType,
                        DisplayValue = specimenType,
                        Hint = "Found in specimen information",
                        FieldPath = "SPM-4",
                        Confidence = 85
                    });
                }
                // Fallback to OBR-15 if SPM not available
                if (parseResult.OrderData.TryGetValue("SpecimenSource", out var specimenSource) && !string.IsNullOrEmpty(specimenSource))
                {
                    candidates.Add(new CandidateValue
                    {
                        Value = specimenSource,
                        DisplayValue = specimenSource,
                        Hint = "Found in order specimen source",
                        FieldPath = "OBR-15",
                        Confidence = 75
                    });
                }
                break;

            case "biomarker":
                if (parseResult.ResultData.Any())
                {
                    // Collect all unique test names from observations
                    var testNames = new List<string>();
                    var testCodes = new List<string>();

                    foreach (var result in parseResult.ResultData)
                    {
                        if (result.TryGetValue("TestName", out var observationName) && !string.IsNullOrEmpty(observationName))
                        {
                            testNames.Add(observationName);
                        }
                        if (result.TryGetValue("TestCode", out var observationCode) && !string.IsNullOrEmpty(observationCode))
                        {
                            testCodes.Add(observationCode);
                        }
                    }

                    // Suggest OBX-3.2 (Test Name) if available
                    if (testNames.Any())
                    {
                        var isMultiObservation = testNames.Count > 1;
                        var displayValue = isMultiObservation
                            ? $"{testNames.Count} observations: {string.Join(", ", testNames.Take(3))}{(testNames.Count > 3 ? "..." : "")}"
                            : testNames[0];

                        var hint = isMultiObservation
                            ? $"Found {testNames.Count} observations in OBX-3.2 (applies to all)"
                            : "Found in observation test name (OBX-3.2)";

                        candidates.Add(new CandidateValue
                        {
                            Value = string.Join("|", testNames), // Store all for reference
                            DisplayValue = displayValue,
                            Hint = hint,
                            FieldPath = "OBX-3.2",
                            Confidence = 90
                        });
                    }

                    // Suggest OBX-3.1 (Test Code) as alternative
                    if (testCodes.Any())
                    {
                        var isMultiObservation = testCodes.Count > 1;
                        var displayValue = isMultiObservation
                            ? $"{testCodes.Count} codes: {string.Join(", ", testCodes.Take(3))}{(testCodes.Count > 3 ? "..." : "")}"
                            : testCodes[0];

                        var hint = isMultiObservation
                            ? $"Found {testCodes.Count} codes in OBX-3.1 (LOINC/local codes)"
                            : "Found in observation identifier (OBX-3.1)";

                        candidates.Add(new CandidateValue
                        {
                            Value = string.Join("|", testCodes),
                            DisplayValue = displayValue,
                            Hint = hint,
                            FieldPath = "OBX-3.1",
                            Confidence = 85
                        });
                    }
                }
                break;
        }

        return candidates;
    }

    private string FormatDate(string hl7Date)
    {
        if (string.IsNullOrEmpty(hl7Date) || hl7Date.Length < 8)
            return hl7Date;

        // HL7 date format: YYYYMMDD or YYYYMMDDHHMMSS
        try
        {
            var year = hl7Date.Substring(0, 4);
            var month = hl7Date.Substring(4, 2);
            var day = hl7Date.Substring(6, 2);
            return $"{day}/{month}/{year}";
        }
        catch
        {
            return hl7Date;
        }
    }

    private List<FieldDefinition> GetFieldDefinitions()
    {
        return new List<FieldDefinition>
