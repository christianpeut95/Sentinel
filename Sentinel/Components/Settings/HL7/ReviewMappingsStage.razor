@using Sentinel.Services.HL7
@using Sentinel.Models
@using Sentinel.Data
@using Microsoft.EntityFrameworkCore
@inject IHL7ParserService ParserService
@inject IHL7FieldMappingService MappingService
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory
@inject ILogger<ReviewMappingsStage> Logger

<div class="wizard-stage">
    <!-- Progress Header -->
    <div class="wizard-progress">
        <div class="progress-step completed">
            <div class="step-number"><i class="bi bi-check"></i></div>
            <div class="step-label">Upload Sample</div>
        </div>
        <div class="progress-connector completed"></div>
        <div class="progress-step active">
            <div class="step-number">2</div>
            <div class="step-label">Review Mappings</div>
        </div>
        <div class="progress-connector"></div>
        <div class="progress-step">
            <div class="step-number">3</div>
            <div class="step-label">Test & Activate</div>
        </div>
    </div>

    <!-- Layout with Sidebar -->
    <div style="display: flex; gap: 32px; max-width: 1200px; margin: 0 auto;">
        <!-- Main Content -->
        <div style="flex: 1; min-width: 0;">
        @if (IsLoading)
        {
            <div class="loading-state">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Analyzing your message...</p>
            </div>
        }
        else
        {
            <!-- Message Preview (Collapsible) -->
            <div class="message-preview-section">
                <button class="preview-toggle" @onclick="TogglePreview">
                    <i class="bi bi-@(ShowPreview ? "chevron-down" : "chevron-right")"></i>
                    <span class="preview-label">
                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                        Message parsed successfully
                    </span>
                    <span class="preview-hint">@AllParsedFields.Count fields found</span>
                </button>

                @if (ShowPreview)
                {
                    <div class="preview-content">
                        <div class="preview-grid">
                            @if (ParsedPatientData.Any())
                            {
                                <div class="preview-section">
                                    <div class="preview-section-title">
                                        <i class="bi bi-person"></i> Patient Information
                                    </div>
                                    @foreach (var item in ParsedPatientData.Take(5))
                                    {
                                        <div class="preview-item">
                                            <span class="preview-key">@item.Key:</span>
                                            <span class="preview-value">@item.Value</span>
                                        </div>
                                    }
                                    @if (ParsedPatientData.Count > 5)
                                    {
                                        <div class="preview-more">+@(ParsedPatientData.Count - 5) more fields</div>
                                    }
                                </div>
                            }

                            @if (ParsedOrderData.Any())
                            {
                                <div class="preview-section">
                                    <div class="preview-section-title">
                                        <i class="bi bi-clipboard-data"></i> Order Information
                                    </div>
                                    @foreach (var item in ParsedOrderData.Take(5))
                                    {
                                        <div class="preview-item">
                                            <span class="preview-key">@item.Key:</span>
                                            <span class="preview-value">@item.Value</span>
                                        </div>
                                    }
                                    @if (ParsedOrderData.Count > 5)
                                    {
                                        <div class="preview-more">+@(ParsedOrderData.Count - 5) more fields</div>
                                    }
                                </div>
                            }

                            @if (ParsedResultData.Any())
                            {
                                <div class="preview-section">
                                    <div class="preview-section-title">
                                        <i class="bi bi-clipboard-check"></i> Results (@ParsedResultData.Count)
                                    </div>
                                    @foreach (var result in ParsedResultData.Take(3))
                                    {
                                        <div class="preview-result-item">
                                            @if (result.TryGetValue("TestName", out var testName))
                                            {
                                                <div class="preview-key">@testName</div>
                                            }
                                            @if (result.TryGetValue("Result", out var resultValue))
                                            {
                                                <div class="preview-value">@resultValue</div>
                                            }
                                        </div>
                                    }
                                    @if (ParsedResultData.Count > 3)
                                    {
                                        <div class="preview-more">+@(ParsedResultData.Count - 3) more results</div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            @if (CurrentFieldIndex < Fields.Count)
            {
            var field = Fields[CurrentFieldIndex];

            <!-- Field Card -->
            <div class="field-card">
                <!-- Progress Indicator -->
                <div class="card-header">
                    <div class="field-progress">
                        <span class="progress-text">Field @(CurrentFieldIndex + 1) of @Fields.Count</span>
                        <div class="progress-bar-wrapper">
                            <div class="progress-bar-fill" style="width: @(((double)(CurrentFieldIndex + 1) / Fields.Count * 100).ToString("F0"))%"></div>
                        </div>
                    </div>
                    @if (!field.IsRequired)
                    {
                        <span class="optional-badge">Optional</span>
                    }
                </div>

                <!-- Field Info -->
                <div class="card-body">
                    <h3 class="field-title">@field.FriendlyName</h3>
                    <p class="field-description">@field.HelpText</p>

                    @* Multi-observation info message *@
                    @if (IsMultiObservationField(field))
                    {
                        <div style="padding: 12px; background: #EFF6FF; border-left: 3px solid #3B82F6; border-radius: 4px; margin-bottom: 16px;">
                            <div style="display: flex; align-items: start; gap: 8px;">
                                <i class="bi bi-info-circle" style="color: #3B82F6; font-size: 18px; margin-top: 2px;"></i>
                                <div style="flex: 1;">
                                    <div style="font-weight: 600; color: #1E40AF; margin-bottom: 4px;">Multiple Observations Detected</div>
                                    <div style="font-size: 13px; color: #1E3A8A; line-height: 1.5;">
                                        This sample message contains @ParsedResultData.Count observations. 
                                        The mapping you select will be applied to <strong>all observations</strong> in future messages.
                                        Each observation will create a separate test marker.
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    @if (field.Candidates != null && field.Candidates.Any())
                    {
                        <!-- Show candidates -->
                        <div class="candidates-section">
                            <div class="section-label">
                                <i class="bi bi-search"></i>
                                Found @field.Candidates.Count possible value@(field.Candidates.Count == 1 ? "" : "s")
                            </div>

                            @foreach (var candidate in field.Candidates)
                            {
                                <div class="candidate-card @(SelectedCandidateFieldPath == candidate.FieldPath ? "selected" : "")"
                                     @onclick="() => SelectCandidate(candidate)">
                                    <div class="candidate-radio">
                                        @if (SelectedCandidateFieldPath == candidate.FieldPath)
                                        {
                                            <i class="bi bi-check-circle-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-circle"></i>
                                        }
                                    </div>
                                    <div class="candidate-content">
                                        <div class="candidate-value">@candidate.DisplayValue</div>
                                        <div class="candidate-hint">@candidate.Hint</div>
                                        @if (candidate.Confidence.HasValue && candidate.Confidence >= 80)
                                        {
                                            <div class="confidence-badge">@candidate.Confidence% confident</div>
                                        }
                                    </div>
                                </div>
                            }

                            <!-- Show manually selected field if not in candidates -->
                            @if (!string.IsNullOrEmpty(SelectedCandidateFieldPath) && 
                                 !field.Candidates.Any(c => c.FieldPath == SelectedCandidateFieldPath))
                            {
                                <div class="candidate-card selected manual-selection">
                                    <div class="candidate-radio">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <div class="candidate-content">
                                        <div class="candidate-value">@SelectedCandidateValue</div>
                                        <div class="candidate-hint">Manually selected from: @SelectedCandidateFieldPath</div>
                                        <div class="confidence-badge" style="background: #10b981;">Manually selected</div>
                                    </div>
                                </div>
                            }

                            <button class="btn-text" @onclick="() => ShowAllFields(field)">
                                <i class="bi bi-list-ul"></i>
                                Can't find it? Browse all fields in the message
                            </button>
                        </div>
                    }
                    else
                    {
                        <!-- No candidates found -->
                        <div class="no-candidates">
                            <i class="bi bi-search"></i>
                            <p>Couldn't automatically find this field in your message.</p>

                            <!-- Show manually selected field if exists -->
                            @if (!string.IsNullOrEmpty(SelectedCandidateValue))
                            {
                                <div class="candidate-card selected manual-selection" style="margin-bottom: 16px;">
                                    <div class="candidate-radio">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <div class="candidate-content">
                                        <div class="candidate-value">@SelectedCandidateValue</div>
                                        <div class="candidate-hint">From: @SelectedCandidateFieldPath</div>
                                        <div class="confidence-badge" style="background: #10b981;">Selected</div>
                                    </div>
                                </div>
                            }

                            <button class="btn-secondary" @onclick="() => ShowAllFields(field)">
                                <i class="bi bi-list-ul"></i>
                                Browse all fields in the message
                            </button>
                        </div>
                    }
                </div>

                <!-- Card Actions -->
                <div class="card-actions">
                    <div class="action-left">
                        @if (CurrentFieldIndex > 0)
                        {
                            <button class="btn-ghost" @onclick="PreviousField">
                                <i class="bi bi-arrow-left"></i>
                                Previous
                            </button>
                        }
                    </div>
                    <div class="action-right">
                        @if (!field.IsRequired)
                        {
                            <button class="btn-ghost" @onclick="SkipField">
                                Skip this field
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        }
                        <button class="btn-primary" 
                                @onclick="ConfirmField"
                                disabled="@(string.IsNullOrEmpty(SelectedCandidateValue) && field.Candidates?.Any() == true)">
                            @if (CurrentFieldIndex == Fields.Count - 1)
                            {
                                <span>Complete Review</span>
                            }
                            else
                            {
                                <span>Confirm & Continue</span>
                            }
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </div>
                </div>
            </div>
            }
        }
        </div>

        <!-- Field Summary Sidebar (Right Side) -->
        @if (!IsLoading && Fields.Any())
        {
            <div style="width: 320px; flex-shrink: 0; background: #ECEAE1; border-radius: 8px; padding: 0; height: calc(100vh - 180px); position: sticky; top: 20px; box-shadow: 0 1px 3px rgba(12,42,32,.08), 0 1px 2px rgba(12,42,32,.04); overflow: hidden; display: flex; flex-direction: column; border: 1px solid #D8D4C4;">
                <!-- Header -->
                <div style="padding: 20px 20px 16px 20px; border-bottom: 1px solid #D8D4C4; flex-shrink: 0;">
                    <div style="font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .12em; text-transform: uppercase; color: #6B7A78; margin-bottom: 8px; font-weight: 500;">Field Progress</div>
                    <h4 style="font-size: 18px; font-weight: 600; color: #0C2A20; margin: 0; letter-spacing: -.02em;">Mapping Status</h4>
                </div>

                <!-- Stats -->
                <div style="display: flex; gap: 12px; padding: 16px 20px; background: #FBFAF5; border-bottom: 1px solid #D8D4C4; flex-shrink: 0;">
                    <div style="flex: 1; padding: 12px; background: white; border: 1px solid #D8D4C4; border-radius: 6px;">
                        <div style="font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #4A5A55; font-weight: 500; margin-bottom: 4px;">Mapped</div>
                        <div style="font-size: 28px; font-weight: 600; color: #159C6E; line-height: 1; letter-spacing: -.03em;">@ConfirmedMappingsCount</div>
                    </div>
                    <div style="flex: 1; padding: 12px; background: white; border: 1px solid #D8D4C4; border-radius: 6px;">
                        <div style="font-family: 'Geist Mono', monospace; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #4A5A55; font-weight: 500; margin-bottom: 4px;">Total</div>
                        <div style="font-size: 28px; font-weight: 600; color: #0C2A20; line-height: 1; letter-spacing: -.03em;">@Fields.Count</div>
                    </div>
                </div>

                <!-- Fields List (Scrollable) -->
                <div style="flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 2px;">
                    <div style="font-family: 'Geist Mono', monospace; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: #6B7A78; margin: 0 8px 8px 8px; font-weight: 500;">Required Fields</div>

                    @foreach (var field in Fields.Where(f => f.IsRequired))
                    {
                        var fieldIndex = Fields.IndexOf(field);
                        var isCurrent = fieldIndex == CurrentFieldIndex;
                        var isMapped = ConfirmedMappings.ContainsKey(field.Key);

                        <div style="display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 4px; cursor: pointer; transition: background .12s, color .12s; background: @(isCurrent ? "#0C2A20" : "transparent"); color: @(isCurrent ? "#3DD598" : "#0C2A20");"
                             @onclick="() => JumpToField(fieldIndex)">
                            <div style="font-size: 14px; flex-shrink: 0;">
                                @if (isMapped)
                                {
                                    <i class="bi bi-check-circle-fill" style="color: @(isCurrent ? "#3DD598" : "#159C6E");"></i>
                                }
                                else if (isCurrent)
                                {
                                    <i class="bi bi-arrow-right-circle-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-circle" style="color: #6B7A78;"></i>
                                }
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div style="font-size: 13px; font-weight: @(isCurrent ? "500" : "400"); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; letter-spacing: -.005em;">
                                    @field.FriendlyName
                                </div>
                            </div>
                        </div>
                    }

                    @if (Fields.Any(f => !f.IsRequired))
                    {
                        <div style="font-family: 'Geist Mono', monospace; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: #6B7A78; margin: 16px 8px 8px 8px; font-weight: 500;">Optional Fields</div>

                        @foreach (var field in Fields.Where(f => !f.IsRequired))
                        {
                            var fieldIndex = Fields.IndexOf(field);
                            var isCurrent = fieldIndex == CurrentFieldIndex;
                            var isMapped = ConfirmedMappings.ContainsKey(field.Key);

                            <div style="display: flex; align-items: center; gap: 10px; padding: 7px 10px; border-radius: 4px; cursor: pointer; transition: background .12s, color .12s; background: @(isCurrent ? "#0C2A20" : "transparent"); color: @(isCurrent ? "#3DD598" : "#4A5A55");"
                                 @onclick="() => JumpToField(fieldIndex)">
                                <div style="font-size: 14px; flex-shrink: 0;">
                                    @if (isMapped)
                                    {
                                        <i class="bi bi-check-circle-fill" style="color: @(isCurrent ? "#3DD598" : "#159C6E");"></i>
                                    }
                                    else if (isCurrent)
                                    {
                                        <i class="bi bi-arrow-right-circle-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-circle" style="color: #B8C0BE;"></i>
                                    }
                                </div>
                                <div style="flex: 1; min-width: 0;">
                                    <div style="font-size: 13px; font-weight: @(isCurrent ? "500" : "400"); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; letter-spacing: -.005em;">
                                        @field.FriendlyName
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Mapped Data Preview -->
                @if (ConfirmedMappings.Any())
                {
                    <div style="padding: 16px 20px; border-top: 1px solid #D8D4C4; background: #FBFAF5; flex-shrink: 0; max-height: 280px; overflow-y: auto;">
                        <div style="font-family: 'Geist Mono', monospace; font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: #6B7A78; margin-bottom: 12px; font-weight: 500;">
                            <i class="bi bi-eye"></i> Mapped Values Preview
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            @foreach (var mapping in ConfirmedMappings.Take(5))
                            {
                                var fieldDef = Fields.FirstOrDefault(f => f.Key == mapping.Key);
                                <div style="padding: 10px; background: white; border: 1px solid #D8D4C4; border-radius: 4px;">
                                    <div style="font-family: 'Geist Mono', monospace; font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: #6B7A78; margin-bottom: 4px;">
                                        @(fieldDef?.FriendlyName ?? mapping.Key)
                                    </div>
                                    <div style="font-size: 13px; color: #0C2A20; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                        @mapping.Value.Value
                                    </div>
                                </div>
                            }
                            @if (ConfirmedMappings.Count > 5)
                            {
                                <div style="font-family: 'Geist Mono', monospace; font-size: 10px; color: #6B7A78; text-align: center; padding: 4px;">
                                    +@(ConfirmedMappings.Count - 5) more mapped
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Bottom Actions -->
    <div class="bottom-actions">
        <button class="btn-text" @onclick="BackToUpload">
            <i class="bi bi-arrow-left"></i>
            Upload a different sample
        </button>
    </div>
</div>

<!-- Browse All Fields Modal -->
@if (ShowBrowseModal && CurrentField != null)
{
    <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); display: flex; align-items: center; justify-content: center; z-index: 10000; padding: 20px;" 
         @onclick="CloseBrowseModal">
        <div style="background: white; border-radius: 8px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); max-width: 800px; width: 100%; max-height: 80vh; display: flex; flex-direction: column; pointer-events: all;" 
             @onclick:stopPropagation="true">
            <div style="padding: 20px 24px; border-bottom: 1px solid #e5e7eb; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
                <h4 style="margin: 0; font-size: 18px; font-weight: 600; color: #1f2937;">Select field for: @CurrentField.FriendlyName</h4>
                <button type="button" 
                        style="background: none; border: none; padding: 8px; cursor: pointer; color: #6b7280; border-radius: 4px; font-size: 20px;"
                        @onclick="CloseBrowseModal">
                    <i class="bi bi-x"></i>
                </button>
            </div>
            <div style="padding: 24px; overflow-y: auto; flex: 1; min-height: 0;">
                <input type="text" 
                       style="width: 100%; padding: 10px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; margin-bottom: 16px;"
                       placeholder="Search fields..." 
                       @bind="SearchQuery"
                       @bind:event="oninput" />

                <div style="display: flex; flex-direction: column; gap: 8px; max-height: 450px; overflow-y: auto; padding: 4px;">
                    @* DEBUG: Show total count and first few fields *@
                    <div style="padding: 8px; background: #f3f4f6; border-radius: 4px; font-size: 12px; color: #6b7280; margin-bottom: 8px;">
                        <strong>Debug Info:</strong> Total fields: @AllParsedFields.Count, 
                        Filtered fields: @AllParsedFields.Where(f => string.IsNullOrEmpty(SearchQuery) || 
                                                                     f.Path.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                                                     f.Value.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)).Count()
                    </div>

                    @foreach (var segment in AllParsedFields.Where(f => string.IsNullOrEmpty(SearchQuery) || 
                                                                         f.Path.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                                                                         f.Value.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase)))
                    {
                        <div style="padding: 12px 16px; border: 1px solid #e5e7eb; border-radius: 6px; cursor: pointer; background: white; transition: all 0.15s;"
                             @onclick="@(() => SelectBrowsedField(segment))">
                            <div style="font-family: 'Courier New', monospace; font-size: 12px; color: #6b7280; margin-bottom: 4px; user-select: all;">
                                @segment.Path
                            </div>
                            <div style="font-size: 14px; color: #1f2937; font-weight: 500; user-select: all;">
                                @segment.Value
                            </div>

                            @* Show all observation values if this is an OBX field with multiple observations *@
                            @if (segment.AllValues != null && segment.AllValues.Count > 1)
                            {
                                <div style="margin-top: 8px; padding: 8px; background: #f9fafb; border-radius: 4px; border-left: 3px solid #3b82f6;">
                                    <div style="font-size: 11px; font-weight: 600; color: #6b7280; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">
                                        <i class="bi bi-stack"></i> All @segment.AllValues.Count Observations
                                    </div>
                                    @foreach (var value in segment.AllValues)
                                    {
                                        <div style="font-size: 13px; color: #374151; padding: 4px 0; border-bottom: 1px solid #e5e7eb;">
                                            @value
                                        </div>
                                    }
                                    <div style="font-size: 11px; color: #6b7280; margin-top: 6px; font-style: italic;">
                                        This mapping will apply to all observations in future messages
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ConfigurationId { get; set; }
    [Parameter] public string SampleMessage { get; set; } = string.Empty;
    [Parameter] public EventCallback OnAllFieldsConfirmed { get; set; }
    [Parameter] public EventCallback OnBackToUpload { get; set; }

    private List<FieldToReview> Fields { get; set; } = new();
    private int CurrentFieldIndex { get; set; } = 0;
    private bool IsLoading { get; set; } = true;
    private string? SelectedCandidateValue { get; set; }
    private string? SelectedCandidateFieldPath { get; set; }

    // Preview state
    private bool ShowPreview { get; set; } = false;
    private Dictionary<string, string> ParsedPatientData { get; set; } = new();
    private Dictionary<string, string> ParsedOrderData { get; set; } = new();
    private List<Dictionary<string, string>> ParsedResultData { get; set; } = new();

    // Browse modal
    private bool ShowBrowseModal { get; set; }
    private FieldToReview? CurrentField { get; set; }
    private string SearchQuery { get; set; } = string.Empty;
    private List<ParsedField> AllParsedFields { get; set; } = new();

    // Sidebar summary - track confirmed mappings (value + path)
    private Dictionary<string, (string Value, string Path)> ConfirmedMappings { get; set; } = new();
    private int ConfirmedMappingsCount => ConfirmedMappings.Count;

    private FieldToReview? CurrentFieldToReview => CurrentFieldIndex < Fields.Count ? Fields[CurrentFieldIndex] : null;

    protected override async Task OnInitializedAsync()
    {
        Logger.LogWarning("========== ReviewMappingsStage OnInitializedAsync ==========");
        Logger.LogWarning("ConfigurationId: {ConfigId}", ConfigurationId);
        Logger.LogWarning("SampleMessage length: {Length}", SampleMessage?.Length ?? 0);
        await LoadFieldsToReview();
    }

    private async Task LoadFieldsToReview()
    {
        IsLoading = true;
        StateHasChanged();

        try
        {
            await using var context = await DbContextFactory.CreateDbContextAsync();

            // DEBUG: Log sample message preview
            var messagePreview = SampleMessage.Length > 500 ? SampleMessage.Substring(0, 500) : SampleMessage;
            Logger.LogInformation("Parsing sample message (first 500 chars): {Preview}", messagePreview);
            Logger.LogInformation("Sample message total length: {Length}", SampleMessage.Length);

            // Parse the sample message
            var parseResult = await ParserService.ParseMessagePreviewAsync(SampleMessage);

            Logger.LogInformation("Parse result - Patient fields: {PatientCount}, Order fields: {OrderCount}, Results: {ResultCount}",
                parseResult.PatientData.Count,
                parseResult.OrderData.Count,
                parseResult.ResultData.Count);

            // DEBUG: Log each result observation for troubleshooting
            for (int i = 0; i < parseResult.ResultData.Count; i++)
            {
                var result = parseResult.ResultData[i];
                Logger.LogInformation("Result[{Index}] has {FieldCount} fields: {Fields}", 
                    i, 
                    result.Count,
                    string.Join(", ", result.Keys));
            }

            // Store parsed data for preview
            ParsedPatientData = parseResult.PatientData;
            ParsedOrderData = parseResult.OrderData;
            ParsedResultData = parseResult.ResultData;

            // Store all parsed fields for browse modal
            AllParsedFields = ExtractAllFields(parseResult);

            Logger.LogInformation("Total parsed fields for browsing: {Count}", AllParsedFields.Count);

            // DEBUG: Count fields by segment type
            var fieldsBySegment = AllParsedFields.GroupBy(f => f.Path.Split('.')[0]).ToDictionary(g => g.Key, g => g.Count());
            foreach (var kvp in fieldsBySegment)
            {
                Logger.LogInformation("  - {Segment}: {Count} fields", kvp.Key, kvp.Value);
            }

            // Get field definitions
            var fieldDefinitions = GetFieldDefinitions();

            // Load existing mappings
            var mappingList = await context.HL7FieldMappings
                .Where(m => m.ConfigurationId == ConfigurationId && m.IsActive)
                .ToListAsync();

            Logger.LogInformation("ReviewMappingsStage: Found {Count} existing active mappings for config {ConfigId}",
                mappingList.Count, ConfigurationId);

            var existingMappings = mappingList.ToDictionary(m => $"{m.TargetEntity}_{m.TargetProperty}");

            // Build fields to review (all fields, including already-mapped ones)
            Fields = new List<FieldToReview>();

            foreach (var fieldDef in fieldDefinitions.OrderBy(f => f.Priority))
            {
                var key = $"{fieldDef.TargetEntity}_{fieldDef.TargetProperty}";
                var hasMapping = existingMappings.ContainsKey(key);

                Logger.LogInformation("  Checking field {Key} ({FriendlyName}): hasMapping={HasMapping}",
                    key, fieldDef.FriendlyName, hasMapping);

                // Detect candidates
                var candidates = await DetectCandidatesAsync(parseResult, fieldDef);

                // If field already has a mapping, add it to confirmed mappings for the sidebar
                if (hasMapping)
                {
                    var mapping = existingMappings[key];
                    var isConfirmed = !string.IsNullOrEmpty(mapping.FieldPath) && mapping.FieldPath != "SKIPPED";
                    Logger.LogInformation("    Existing mapping FieldPath={FieldPath}, IsConfirmed={IsConfirmed}",
                        mapping.FieldPath, isConfirmed);

                    if (isConfirmed)
                    {
                        // Find the actual value from parsed fields for preview
                        var matchedField = AllParsedFields.FirstOrDefault(f => f.Path == mapping.FieldPath);
                        var mappedValue = matchedField?.Value ?? mapping.FieldPath; // Fallback to path if value not found

                        // Add to confirmed mappings for sidebar preview
                        ConfirmedMappings[key] = (mappedValue, mapping.FieldPath);
                        Logger.LogInformation("    Pre-loaded existing mapping into ConfirmedMappings: {Value} from {Path}", 
                            mappedValue, mapping.FieldPath);
                    }
                }

                Fields.Add(new FieldToReview
                {
                    Key = fieldDef.Key,
                    FriendlyName = fieldDef.FriendlyName,
                    HelpText = fieldDef.HelpText,
                    IsRequired = fieldDef.IsRequired,
                    TargetEntity = fieldDef.TargetEntity,
                    TargetProperty = fieldDef.TargetProperty,
                    Candidates = candidates
                });
            }

            Logger.LogInformation("ReviewMappingsStage: Built {FieldCount} fields to review", Fields.Count);

            // If no fields to review, we're done
            if (!Fields.Any())
            {
                Logger.LogWarning("ReviewMappingsStage: No fields to review - moving directly to next stage");
                await OnAllFieldsConfirmed.InvokeAsync();
            }
            else
            {
                // Load saved selection for the first field if available
                LoadSavedSelectionForCurrentField();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading fields to review");
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private string? GetParsedValueForPath(string fieldPath, HL7ParseResult parseResult)
    {
        // Try to find the value in parsed data by field path
        var field = AllParsedFields.FirstOrDefault(f => f.Path == fieldPath);
        return field?.Value;
    }

