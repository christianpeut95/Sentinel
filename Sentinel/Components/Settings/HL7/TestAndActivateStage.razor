        opacity: 0.6;
        cursor: not-allowed;
    }

    .btn-secondary {
        background: var(--paper);
        color: var(--forest);
        border: 1px solid var(--hairline);
    }

    .btn-secondary:hover:not(:disabled) {
        background: white;
    }

    .btn-ghost {
        background: transparent;
        color: var(--graphite);
    }

    .btn-ghost:hover {
        background: var(--paper);
    }
</style>
