@using System.ComponentModel.DataAnnotations

<div class="stage-card">
    <div class="stage-header">
        <h2><i class="bi bi-globe2"></i> Application Address</h2>
        <p>Enter the address people use to access Sentinel.</p>
    </div>

    <div class="stage-body">
        <EditForm Model="@HttpsData" OnValidSubmit="HandleNext">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label required">Application URL</label>
                <InputText @bind-Value="HttpsData.ApplicationUrl" class="form-control" placeholder="https://sentinel.example.com" />
                <ValidationMessage For="@(() => HttpsData.ApplicationUrl)" class="validation-message" />
                <span class="form-text">Use your public HTTPS address for a production deployment. Local evaluation installations may use HTTP.</span>
            </div>

            <div class="form-group">
                <label class="form-label">Domain Name (optional)</label>
                <InputText @bind-Value="HttpsData.DomainName" class="form-control" placeholder="sentinel.example.com" />
                <span class="form-text">Your custom domain name (if different from Application URL).</span>
            </div>

            <div class="form-group">
                <label class="form-label">SSL Certificate Path (optional)</label>
                <InputText @bind-Value="HttpsData.SslCertPath" class="form-control" placeholder="/path/to/certificate.pfx" />
                <span class="form-text">Path to your SSL certificate file if using Kestrel directly.</span>
            </div>

            <div class="stage-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandlePrevious">
                    <i class="bi bi-arrow-left"></i>
                    <span>Previous</span>
                </button>
                <button type="submit" class="btn btn-primary">
                    <span>Next</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public InitialSetupWizard.HttpsConfigData HttpsData { get; set; } = new();
    [Parameter] public EventCallback<InitialSetupWizard.HttpsConfigData> HttpsDataChanged { get; set; }

    private async Task HandleNext()
    {
        await HttpsDataChanged.InvokeAsync(HttpsData);
        await OnNext.InvokeAsync();
    }

    private async Task HandlePrevious()
    {
        await OnPrevious.InvokeAsync();
    }
}
