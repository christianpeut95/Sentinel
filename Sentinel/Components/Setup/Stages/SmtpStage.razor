@using Sentinel.Services.Email
@using Sentinel.Services
@using System.ComponentModel.DataAnnotations
@using MailKit.Net.Smtp
@using MimeKit
@inject ILogger<SmtpStage> Logger
@inject IConfiguration Configuration

<div class="stage-card">
    <div class="stage-header">
        <h2><i class="bi bi-envelope"></i> SMTP Configuration</h2>
        <p>Configure email settings for notifications and password resets (optional).</p>
    </div>

    <div class="stage-body">
        <EditForm Model="@SmtpData" OnValidSubmit="HandleNext">
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                SMTP configuration enables password reset emails and system notifications. This is optional but highly recommended.
            </div>

            @if (!string.IsNullOrEmpty(_testResult))
            {
                @if (_testSuccessful)
                {
                    <div class="alert alert-success">
                        <i class="bi bi-check-circle-fill"></i>
                        @_testResult
                    </div>
                }
                else
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        @_testResult
                    </div>
                }
            }

            <div class="form-group">
                <label class="form-label">SMTP Host</label>
                <InputText @bind-Value="SmtpData.Host" class="form-control" placeholder="smtp.gmail.com" />
                <span class="form-text">SMTP server hostname.</span>
            </div>

            <div class="form-group">
                <label class="form-label">SMTP Port</label>
                <InputNumber @bind-Value="SmtpData.Port" class="form-control" min="1" max="65535" />
                <span class="form-text">Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted).</span>
            </div>

            <div class="form-check" style="margin-bottom: 1.5rem;">
                <InputCheckbox @bind-Value="SmtpData.EnableSsl" class="form-check-input" id="enableSslCheck" />
                <label class="form-check-label" for="enableSslCheck">
                    Enable SSL/TLS (Recommended)
                </label>
            </div>

            <div class="form-group">
                <label class="form-label">Username</label>
                <InputText @bind-Value="SmtpData.Username" class="form-control" placeholder="your-email@example.com" />
                <span class="form-text">SMTP authentication username (often your email address).</span>
            </div>

            <div class="form-group">
                <label class="form-label">Password</label>
                <InputText @bind-Value="SmtpData.Password" class="form-control" type="password" />
                <span class="form-text">SMTP authentication password or app-specific password.</span>
            </div>

            <div class="form-group">
                <label class="form-label">From Email</label>
                <InputText @bind-Value="SmtpData.FromEmail" class="form-control" type="email" placeholder="noreply@example.com" />
                <span class="form-text">Email address that will appear in the "From" field.</span>
            </div>

            <div class="form-group">
                <label class="form-label">From Display Name</label>
                <InputText @bind-Value="SmtpData.FromDisplayName" class="form-control" placeholder="Sentinel Surveillance System" />
                <span class="form-text">Display name for the sender.</span>
            </div>

            <button type="button" class="btn btn-secondary" @onclick="TestConnection" disabled="@_isTesting" style="margin-bottom: 1.5rem;">
                @if (_isTesting)
                {
                    <span class="spinner"></span>
                    <span>Testing...</span>
                }
                else
                {
                    <i class="bi bi-plug"></i>
                    <span>Test Connection</span>
                }
            </button>

            <div class="stage-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandlePrevious">
                    <i class="bi bi-arrow-left"></i>
                    <span>Previous</span>
                </button>
                <div style="display: flex; gap: 0.75rem;">
                    <button type="button" class="btn btn-link" @onclick="HandleSkip">
                        Skip for now
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <span>Next</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnSkip { get; set; }
    [Parameter] public InitialSetupWizard.SmtpData SmtpData { get; set; } = new();
    [Parameter] public EventCallback<InitialSetupWizard.SmtpData> SmtpDataChanged { get; set; }

    private bool _isTesting = false;
    private string _testResult = "";
    private bool _testSuccessful = false;

    protected override void OnInitialized()
    {
        // Prefill from appsettings.json or environment variables
        var host = Configuration["Smtp:Host"] ?? Environment.GetEnvironmentVariable("SMTP_HOST");
        var port = Configuration["Smtp:Port"] ?? Environment.GetEnvironmentVariable("SMTP_PORT");
        var enableSsl = Configuration["Smtp:EnableSsl"] ?? Environment.GetEnvironmentVariable("SMTP_ENABLE_SSL");
        var username = Configuration["Smtp:Username"] ?? Environment.GetEnvironmentVariable("SMTP_USERNAME");
        var password = Configuration["Smtp:Password"] ?? Environment.GetEnvironmentVariable("SMTP_PASSWORD");
        var fromEmail = Configuration["Smtp:FromEmail"] ?? Environment.GetEnvironmentVariable("SMTP_FROM_EMAIL");
        var fromName = Configuration["Smtp:FromDisplayName"] ?? Environment.GetEnvironmentVariable("SMTP_FROM_NAME");

        if (!string.IsNullOrEmpty(host))
            SmtpData.Host = host;

        if (!string.IsNullOrEmpty(port) && int.TryParse(port, out var portNum))
            SmtpData.Port = portNum;

        if (!string.IsNullOrEmpty(enableSsl) && bool.TryParse(enableSsl, out var sslEnabled))
            SmtpData.EnableSsl = sslEnabled;

        if (!string.IsNullOrEmpty(username))
            SmtpData.Username = username;

        if (!string.IsNullOrEmpty(password))
            SmtpData.Password = password;

        if (!string.IsNullOrEmpty(fromEmail))
            SmtpData.FromEmail = fromEmail;

        if (!string.IsNullOrEmpty(fromName))
            SmtpData.FromDisplayName = fromName;
    }

    private async Task TestConnection()
    {
        if (string.IsNullOrWhiteSpace(SmtpData.Host) || string.IsNullOrWhiteSpace(SmtpData.FromEmail))
        {
            _testResult = "Please fill in at least SMTP Host and From Email to test the connection.";
            _testSuccessful = false;
            return;
        }

        _isTesting = true;
        _testResult = "";
        StateHasChanged();

        try
        {
            // Create a test SMTP client connection
            using var client = new SmtpClient();

            await client.ConnectAsync(SmtpData.Host, SmtpData.Port, SmtpData.EnableSsl);

            // Try to authenticate if credentials are provided
            if (!string.IsNullOrWhiteSpace(SmtpData.Username) && !string.IsNullOrWhiteSpace(SmtpData.Password))
            {
                await client.AuthenticateAsync(SmtpData.Username, SmtpData.Password);
            }

            await client.DisconnectAsync(true);

            _testResult = "✓ SMTP connection successful! Settings are valid.";
            _testSuccessful = true;

            Logger.LogInformation("SMTP connection test successful for {Host}:{Port}", SmtpData.Host, SmtpData.Port);
        }
        catch (Exception ex)
        {
            _testResult = $"Connection failed: {ex.Message}";
            _testSuccessful = false;
            Logger.LogWarning(ex, "SMTP connection test failed for {Host}:{Port}", SmtpData.Host, SmtpData.Port);
        }
        finally
        {
            _isTesting = false;
            StateHasChanged();
        }
    }

    private async Task HandleNext()
    {
        await SmtpDataChanged.InvokeAsync(SmtpData);
        await OnNext.InvokeAsync();
    }

    private async Task HandlePrevious()
    {
        await OnPrevious.InvokeAsync();
    }

    private async Task HandleSkip()
    {
        // Clear data when skipping
        SmtpData = new InitialSetupWizard.SmtpData();
        await SmtpDataChanged.InvokeAsync(SmtpData);
        await OnSkip.InvokeAsync();
    }
}
