@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using Sentinel.Components.Setup
@using Sentinel.Data
@using Sentinel.Models
@using Sentinel.Services
@using System.Text.Json
@using System.Text.Json.Nodes
@inject ApplicationDbContext DbContext
@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject ISystemSettingsService SystemSettingsService
@inject ISetupWizardState SetupWizardState
@inject IWebDataRocksLicenseService WebDataRocksLicense
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment
@inject ILogger<ReviewStage> Logger

<div class="stage-card">
    <div class="stage-header">
        <h2><i class="bi bi-check-circle"></i> Review & Complete Setup</h2>
        <p>Review your configuration and complete the setup process.</p>
    </div>

    <div class="stage-body">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Setup failed:</strong> @_error
            </div>
        }

        @if (_isCompleting)
        {
            <div class="alert alert-info">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span class="spinner"></span>
                    <div>
                        <strong>@_currentStep</strong>
                        <br />
                        <small>Please wait while we configure your system...</small>
                    </div>
                </div>
            </div>
        }

        <!-- Administrator Account -->
        <div class="review-section">
            <h3><i class="bi bi-person-badge"></i> Administrator Account</h3>
            <div class="review-item">
                <span class="review-label">Email</span>
                <span class="review-value">@AdminData.Email</span>
            </div>
            <div class="review-item">
                <span class="review-label">Full Name</span>
                <span class="review-value">@AdminData.FullName</span>
            </div>
            @if (!string.IsNullOrEmpty(AdminData.RecoveryEmail))
            {
                <div class="review-item">
                    <span class="review-label">Recovery Email</span>
                    <span class="review-value">@AdminData.RecoveryEmail</span>
                </div>
            }
            @if (AdminData.CreateBackupAdmin)
            {
                <div class="review-item">
                    <span class="review-label">Backup Admin</span>
                    <span class="review-value">@AdminData.BackupEmail</span>
                </div>
            }
        </div>

        <!-- HTTPS & Domain -->
        <div class="review-section">
            <h3><i class="bi bi-shield-lock"></i> HTTPS & Domain</h3>
            <div class="review-item">
                <span class="review-label">Application URL</span>
                <span class="review-value">@HttpsData.ApplicationUrl</span>
            </div>
            <div class="review-item">
                <span class="review-label">Enforce HTTPS</span>
                <span class="review-value">@(HttpsData.EnforceHttps ? "Yes" : "No")</span>
            </div>
            @if (!string.IsNullOrEmpty(HttpsData.DomainName))
            {
                <div class="review-item">
                    <span class="review-label">Domain Name</span>
                    <span class="review-value">@HttpsData.DomainName</span>
                </div>
            }
        </div>

        <!-- Organization -->
        <div class="review-section">
            <h3><i class="bi bi-building"></i> Organization</h3>
            <div class="review-item">
                <span class="review-label">Name</span>
                <span class="review-value">@OrgData.Name</span>
            </div>
            <div class="review-item">
                <span class="review-label">Country</span>
                <span class="review-value">@OrgData.Country</span>
            </div>
            @if (!string.IsNullOrEmpty(OrgData.City))
            {
                <div class="review-item">
                    <span class="review-label">City</span>
                    <span class="review-value">@OrgData.City</span>
                </div>
            }
        </div>

        <!-- Regional settings -->
        <div class="review-section">
            <h3><i class="bi bi-globe2"></i> Regional Settings</h3>
            <div class="review-item">
                <span class="review-label">Selected Time Zone</span>
                <span class="review-value">@TimeZoneDisplayName</span>
            </div>
            <div class="review-item">
                <span class="review-label">Date, Number and Language Format</span>
                <span class="review-value">@LocaleDisplayName</span>
            </div>
        </div>

        <!-- Geocoding -->
        @if (!string.IsNullOrEmpty(GeoData.Provider))
        {
            <div class="review-section">
                <h3><i class="bi bi-geo-alt"></i> Geocoding</h3>
                <div class="review-item">
                    <span class="review-label">Provider</span>
                    <span class="review-value">@GeoData.Provider</span>
                </div>
                @if (!string.IsNullOrEmpty(GeoData.GoogleMapsBrowserApiKey))
                {
                    <div class="review-item">
                        <span class="review-label">Google Places Browser API Key</span>
                        <span class="review-value masked">Configured</span>
                    </div>
                }
            </div>
        }

        <!-- Optional feedback and remote diagnostics -->
        <div class="review-section">
            <h3><i class="bi bi-chat-square-text"></i> Optional Feedback & Diagnostics</h3>
            <div class="review-item">
                <span class="review-label">Feedback Widget</span>
                <span class="review-value">@(EnableFeedback ? "Enabled" : "Disabled")</span>
            </div>
            <div class="review-item">
                <span class="review-label">Anonymous Usage & Automatic Error Reporting</span>
                <span class="review-value">@(EnableUsageMonitoring ? "Enabled" : "Disabled")</span>
            </div>
        </div>

        <!-- Optional interactive pivot reporting -->
        <div class="review-section">
            <h3><i class="bi bi-table"></i> Optional Interactive Pivot Reports</h3>
            <p class="review-description">
                Sentinel can use WebDataRocks for interactive pivot reports. It is an optional component provided under its own vendor licence, not the Sentinel GPL licence.
            </p>
            <label class="review-license-toggle" for="enableWebDataRocks">
                <input @bind="_enableWebDataRocks" type="checkbox" role="switch" id="enableWebDataRocks" />
                <span>Enable interactive pivot reports</span>
            </label>
            @if (_enableWebDataRocks)
            {
                <div class="review-license-acceptance">
                    <label class="review-license-check" for="acceptWebDataRocksLicense">
                        <input @bind="_acceptWebDataRocksLicense" type="checkbox" id="acceptWebDataRocksLicense" />
                        <span>
                            I have read and accept the <a href="@WebDataRocksLicenseService.LicenseUrl" target="_blank" rel="noopener noreferrer">WebDataRocks Licence Agreement</a> (revision @WebDataRocksLicenseService.CurrentLicenseVersion) for this organisation.
                        </span>
                    </label>
                    <p>Each Sentinel user will also be asked to accept these terms before their browser loads the pivot component. Vendor attribution and the component’s applicable limits remain in place.</p>
                </div>
            }
        </div>

        <!-- Backup -->
        <div class="review-section">
            <h3><i class="bi bi-hdd"></i> Backup</h3>
            <div class="review-item">
                <span class="review-label">Backup Path</span>
                <span class="review-value">@BackupData.BackupPath</span>
            </div>
            <div class="review-item">
                <span class="review-label">Retention</span>
                <span class="review-value">@BackupData.RetentionDays days</span>
            </div>
        </div>

        <div class="stage-actions">
            <button type="button" class="btn btn-secondary" @onclick="HandlePrevious" disabled="@_isCompleting">
                <i class="bi bi-arrow-left"></i>
                <span>Previous</span>
            </button>
            <button type="button" class="btn btn-primary" @onclick="CompleteSetup" disabled="@_isCompleting">
                @if (_isCompleting)
                {
                    <span class="spinner"></span>
                    <span>Completing Setup...</span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i>
                    <span>Complete Setup</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnComplete { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public InitialSetupWizard.AdminAccountData AdminData { get; set; } = new();
    [Parameter] public InitialSetupWizard.HttpsConfigData HttpsData { get; set; } = new();
    [Parameter] public InitialSetupWizard.OrganizationData OrgData { get; set; } = new();
    [Parameter] public bool EnableFeedback { get; set; }
    [Parameter] public bool EnableUsageMonitoring { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = OrganizationRegionalSettings.DefaultTimeZoneId;
    [Parameter] public string Locale { get; set; } = OrganizationRegionalSettings.DefaultLocale;
    [Parameter] public InitialSetupWizard.GeocodingData GeoData { get; set; } = new();
    [Parameter] public InitialSetupWizard.BackupData BackupData { get; set; } = new();

    private bool _isCompleting = false;
    private string _error = "";
    private string _currentStep = "";
    private bool _enableWebDataRocks;
    private bool _acceptWebDataRocksLicense;

    private string TimeZoneDisplayName
    {
        get
        {
            if (string.IsNullOrWhiteSpace(TimeZoneId))
            {
                return "Not selected";
            }

            if (OrganizationRegionalSettings.TryResolveTimeZone(TimeZoneId, out var timeZone))
            {
                return timeZone.DisplayName;
            }

            return TimeZoneId;
        }
    }

    private string LocaleDisplayName
    {
        get
        {
            if (OrganizationRegionalSettings.TryGetCulture(Locale, out var culture))
            {
                return $"{culture.EnglishName} ({culture.Name})";
            }

            return Locale;
        }
    }

    private async Task CompleteSetup()
    {
        var setupValidationErrors = await ValidateSetupDataAsync();
        if (setupValidationErrors.Count > 0)
        {
            _error = string.Join(" ", setupValidationErrors);
            return;
        }

        if (_enableWebDataRocks && !_acceptWebDataRocksLicense)
        {
            _error = "Accept the WebDataRocks Licence Agreement or leave interactive pivot reports disabled.";
            return;
        }

        _isCompleting = true;
        _error = "";
        StateHasChanged();

        try
        {
            // Revalidate immediately before privileged setup work. The service
            // repeats this check when setup is committed to prevent bypassing
            // expiry or reusing a token after it has been consumed.
            var validatedSetupToken = SetupWizardState.ValidatedToken;
            if (!SetupWizardState.HasValidatedToken
                || string.IsNullOrWhiteSpace(validatedSetupToken)
                || !await SystemSettingsService.ValidateTokenAsync(validatedSetupToken))
            {
                _error = "The setup token is invalid or has expired. Restart the setup process using a current token.";
                _isCompleting = false;
                return;
            }

            // Step 1: Apply pending migrations
            _currentStep = "Applying database migrations...";
            StateHasChanged();
            await DbContext.Database.MigrateAsync();
            Logger.LogInformation("Database migrations applied");

            // Step 2: Create roles
            _currentStep = "Creating system roles...";
            StateHasChanged();
            var rolesToCreate = new[] { "Administrator", "Supervisor", "User" };
            foreach (var roleName in rolesToCreate)
            {
                if (!await RoleManager.RoleExistsAsync(roleName))
                {
                    await RoleManager.CreateAsync(new IdentityRole(roleName));
                    Logger.LogInformation("Created role: {RoleName}", roleName);
                }
            }

            // Step 3: Create admin user
            _currentStep = "Creating administrator account...";
            StateHasChanged();
            var adminUser = new ApplicationUser
            {
                UserName = AdminData.Email,
                Email = AdminData.Email,
                EmailConfirmed = true,
                FirstName = AdminData.FullName?.Split(' ').FirstOrDefault(),
                LastName = AdminData.FullName?.Split(' ').Skip(1).FirstOrDefault()
            };

            var createResult = await UserManager.CreateAsync(adminUser, AdminData.Password);
            if (!createResult.Succeeded)
            {
                _error = string.Join("; ", createResult.Errors.Select(e => e.Description));
                _isCompleting = false;
                return;
            }

            await UserManager.AddToRoleAsync(adminUser, "Admin");
            Logger.LogInformation("Created admin user: {Email}", AdminData.Email);

            // Step 4: Create backup admin if requested
            if (AdminData.CreateBackupAdmin && !string.IsNullOrEmpty(AdminData.BackupEmail))
            {
                _currentStep = "Creating backup administrator...";
                StateHasChanged();

                var backupUser = new ApplicationUser
                {
                    UserName = AdminData.BackupEmail,
                    Email = AdminData.BackupEmail,
                    EmailConfirmed = true,
                    FirstName = AdminData.BackupFullName?.Split(' ').FirstOrDefault() ?? "Backup",
                    LastName = AdminData.BackupFullName?.Split(' ').Skip(1).FirstOrDefault() ?? "Administrator"
                };

                var backupResult = await UserManager.CreateAsync(backupUser, AdminData.BackupPassword!);
                if (backupResult.Succeeded)
                {
                    await UserManager.AddToRoleAsync(backupUser, "Admin");
                    Logger.LogInformation("Created backup admin user: {Email}", AdminData.BackupEmail);
                }
            }

            // Step 5: Save system settings and organization data
            _currentStep = "Saving system settings and organization data...";
            StateHasChanged();

            var settings = await SystemSettingsService.GetSettingsAsync();
            if (settings != null)
            {
                settings.ApplicationUrl = HttpsData.ApplicationUrl;
                settings.EnforceHttps = HttpsData.EnforceHttps;
                // Remote feedback and diagnostic reporting are both explicit
                // setup choices and are disabled unless selected by the admin.
                await SystemSettingsService.UpdateFeedbackWidgetSettingAsync(EnableFeedback);
                await SystemSettingsService.UpdateUsageMonitoringSettingAsync(EnableUsageMonitoring);
                await WebDataRocksLicense.SetOrganizationAcceptanceAsync(
                    _enableWebDataRocks,
                    adminUser.Id);

                if (_enableWebDataRocks)
                {
                    // The setup administrator has explicitly accepted the
                    // terms for the organisation and personally, so avoid a
                    // redundant first-use prompt after their initial sign-in.
                    await WebDataRocksLicense.AcceptForUserAsync(adminUser.Id);
                }

                // Save organization data and timezone to appsettings.json
                try
                {
                    var appsettingsPath = Path.Combine(Environment.ContentRootPath, "appsettings.json");
                    var json = await File.ReadAllTextAsync(appsettingsPath);
                    var jsonDoc = JsonNode.Parse(json);

                    if (jsonDoc != null)
                    {
                        // Ensure Organization section exists
                        if (jsonDoc["Organization"] == null)
                        {
                            jsonDoc["Organization"] = new JsonObject();
                        }

                        // Save organization data
                        jsonDoc["Organization"]!["Name"] = JsonValue.Create(OrgData.Name);
                        jsonDoc["Organization"]!["Country"] = JsonValue.Create(OrgData.Country);
                        jsonDoc["Organization"]!["State"] = JsonValue.Create(OrgData.State);
                        jsonDoc["Organization"]!["City"] = JsonValue.Create(OrgData.City);
                        jsonDoc["Organization"]!["PostalCode"] = JsonValue.Create(OrgData.PostalCode);
                        jsonDoc["Organization"]!["CountryCode"] = JsonValue.Create(OrgData.CountryCode?.ToUpperInvariant());
                        if (!OrganizationRegionalSettings.TryResolveTimeZone(TimeZoneId, out var configuredTimeZone)
                            || !OrganizationRegionalSettings.TryGetCulture(Locale, out var configuredCulture))
                        {
                            throw new InvalidOperationException("Validated regional settings could not be resolved during setup.");
                        }

                        jsonDoc["Organization"]!["TimeZoneId"] = JsonValue.Create(OrganizationRegionalSettings.GetCanonicalTimeZoneId(configuredTimeZone));
                        jsonDoc["Organization"]!["Locale"] = JsonValue.Create(configuredCulture.Name);
                        (jsonDoc["Organization"] as JsonObject)?.Remove("Timezone");

                        // Ensure Geocoding section exists and save geocoding settings
                        if (jsonDoc["Geocoding"] == null)
                        {
                            jsonDoc["Geocoding"] = new JsonObject();
                        }
                        jsonDoc["Geocoding"]!["Provider"] = JsonValue.Create(GeoData.Provider);
                        if (!string.IsNullOrEmpty(GeoData.GoogleMapsBrowserApiKey))
                        {
                            jsonDoc["Geocoding"]!["GoogleMapsBrowserApiKey"] = JsonValue.Create(GeoData.GoogleMapsBrowserApiKey);
                        }
                        if (!string.IsNullOrEmpty(GeoData.Email))
                        {
                            jsonDoc["Geocoding"]!["Email"] = JsonValue.Create(GeoData.Email);
                        }

                        // Ensure Backup section exists and save backup settings
                        if (jsonDoc["Backup"] == null)
                        {
                            jsonDoc["Backup"] = new JsonObject();
                        }
                        jsonDoc["Backup"]!["Path"] = JsonValue.Create(BackupData.BackupPath);
                        jsonDoc["Backup"]!["RetentionDays"] = JsonValue.Create(BackupData.RetentionDays);

                        // Write back to file
                        var options = new JsonSerializerOptions { WriteIndented = true };
                        await File.WriteAllTextAsync(appsettingsPath, jsonDoc.ToJsonString(options));
                        Logger.LogInformation("Organization, geocoding, and backup settings saved to appsettings.json");
                    }
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to save settings to appsettings.json");
                    // Don't fail the setup, just log the error
                }

                // Mark setup as complete
                await SystemSettingsService.CompleteSetupAsync(adminUser.Id, validatedSetupToken);
                SetupWizardState.Clear();
                Logger.LogInformation("Setup completed successfully");
            }

            // Step 6: Complete
            _currentStep = "Setup complete! Redirecting...";
            StateHasChanged();
            await Task.Delay(1000);

            await OnComplete.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Setup failed");
            _error = "Setup could not be completed. Review the application logs for technical details and try again.";
            _isCompleting = false;
            StateHasChanged();
        }
    }

    private async Task HandlePrevious()
    {
        await OnPrevious.InvokeAsync();
    }

    private async Task<IReadOnlyList<string>> ValidateSetupDataAsync()
    {
        var errors = SetupWizardValidation.ValidateRequiredConfiguration(
            AdminData,
            HttpsData,
            OrgData,
            BackupData,
            TimeZoneId,
            Locale).ToList();
        errors.AddRange(SetupWizardValidation.ValidateAdministratorDetails(AdminData));

        if (errors.Count > 0)
        {
            return errors;
        }

        if (await UserManager.FindByEmailAsync(AdminData.Email.Trim()) is not null)
        {
            errors.Add("An administrator account with that email address already exists.");
        }

        var adminCandidate = new ApplicationUser
        {
            UserName = AdminData.Email.Trim(),
            Email = AdminData.Email.Trim()
        };
        errors.AddRange(await ValidatePasswordAsync(adminCandidate, AdminData.Password));

        if (AdminData.CreateBackupAdmin)
        {
            if (await UserManager.FindByEmailAsync(AdminData.BackupEmail!.Trim()) is not null)
            {
                errors.Add("A backup administrator account with that email address already exists.");
            }

            var backupCandidate = new ApplicationUser
            {
                UserName = AdminData.BackupEmail.Trim(),
                Email = AdminData.BackupEmail.Trim()
            };
            errors.AddRange(await ValidatePasswordAsync(backupCandidate, AdminData.BackupPassword!));
        }

        return errors.Distinct(StringComparer.Ordinal).ToArray();
    }

    private async Task<IReadOnlyList<string>> ValidatePasswordAsync(ApplicationUser user, string password)
    {
        var errors = new List<string>();
        foreach (var validator in UserManager.PasswordValidators)
        {
            var result = await validator.ValidateAsync(UserManager, user, password);
            if (!result.Succeeded)
            {
                errors.AddRange(result.Errors.Select(error => error.Description));
            }
        }

        return errors.Distinct(StringComparer.Ordinal).ToArray();
    }
}
