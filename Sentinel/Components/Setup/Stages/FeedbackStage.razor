<div class="stage-card">
    <div class="stage-header">
        <h2><i class="bi bi-chat-dots"></i> User Feedback</h2>
        <p>Help us improve Sentinel by sharing your feedback, reporting bugs, and suggesting features.</p>
    </div>

    <div class="stage-body">
        <div class="info-panel">
            <div class="info-icon">
                <i class="bi bi-shield-check"></i>
            </div>
            <div class="info-content">
                <h4>Privacy-Safe Feedback System</h4>
                <p>
                    The feedback widget connects directly to the Sentinel development team. Submit bugs, feature requests,
                    or general feedback with optional technical diagnostics that help us diagnose and fix issues faster.
                </p>
                <ul class="feature-list">
                    <li><i class="bi bi-check-circle text-success"></i> <strong>Patient privacy protected:</strong> Diagnostic data never includes patient information</li>
                    <li><i class="bi bi-check-circle text-success"></i> <strong>Opt-out anytime:</strong> Disable the widget in Settings whenever you want</li>
                    <li><i class="bi bi-check-circle text-success"></i> <strong>Installation ID:</strong> Feedback is linked to your installation, not individual users</li>
                    <li><i class="bi bi-check-circle text-success"></i> <strong>Optional diagnostics:</strong> Choose whether to include technical information with each submission</li>
                </ul>
            </div>
        </div>

        <div class="privacy-panel">
            <div class="privacy-icon">
                <i class="bi bi-lock-fill"></i>
            </div>
            <div class="privacy-content">
                <h4>What Gets Sent?</h4>
                <div class="privacy-columns">
                    <div class="privacy-safe">
                        <h5>✓ Safe to Include</h5>
                        <ul>
                            <li>Sentinel version and installation ID</li>
                            <li>Operating system and browser info</li>
                            <li>Page route (e.g., /Cases/{'{'}id{'}'}/Edit)</li>
                            <li>Error counts (not messages)</li>
                            <li>Your role (not name/email)</li>
                            <li>Database type (not connection string)</li>
                        </ul>
                    </div>
                    <div class="privacy-never">
                        <h5>✗ Never Included</h5>
                        <ul>
                            <li>Patient names, IDs, or demographics</li>
                            <li>Clinical data or lab results</li>
                            <li>Survey answers or custom fields</li>
                            <li>Credentials or tokens</li>
                            <li>Database contents</li>
                            <li>Your email (unless you provide it)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="feedback-preview">
            <div class="preview-label">Widget Preview</div>
            <div class="preview-button-container">
                <div class="preview-feedback-button">
                    <i class="bi bi-chat-dots"></i>
                </div>
            </div>
            <p class="preview-note">This button will appear in the bottom-right corner of every page</p>
        </div>

        <div class="form-group">
            <div class="form-check">
                <InputCheckbox @bind-Value="EnableFeedback" class="form-check-input" id="enableFeedbackCheck" />
                <label class="form-check-label" for="enableFeedbackCheck">
                    <strong>Enable the feedback widget</strong>
                </label>
            </div>
            <span class="form-text">You can change this setting anytime from the Settings page</span>
        </div>

        <div class="stage-actions">
            <button type="button" class="btn btn-secondary" @onclick="HandlePrevious">
                <i class="bi bi-arrow-left"></i>
                <span>Previous</span>
            </button>
            <button type="button" class="btn btn-primary" @onclick="HandleNext">
                <span>Next</span>
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public bool EnableFeedback { get; set; } = true;
    [Parameter] public EventCallback<bool> EnableFeedbackChanged { get; set; }

    private async Task HandleNext()
    {
        await EnableFeedbackChanged.InvokeAsync(EnableFeedback);
        await OnNext.InvokeAsync();
    }

    private async Task HandlePrevious()
    {
        await OnPrevious.InvokeAsync();
    }
}

