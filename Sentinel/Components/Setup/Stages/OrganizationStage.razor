@using System.ComponentModel.DataAnnotations
@using Sentinel.Services

<div class="stage-card">
    <div class="stage-header">
        <h2><i class="bi bi-building"></i> Organization Information</h2>
        <p>Enter your organization's details.</p>
    </div>

    <div class="stage-body">
        <EditForm Model="@OrgData" OnValidSubmit="HandleNext">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label required">Organization Name</label>
                <InputText @bind-Value="OrgData.Name" class="form-control" placeholder="Health Department" />
                <ValidationMessage For="@(() => OrgData.Name)" class="validation-message" />
            </div>

            <div class="form-group">
                <label class="form-label required">Country/Region</label>
                <InputSelect @bind-Value="OrgData.CountryCode" class="form-control">
                    <option value="">-- Select Country/Region --</option>
                    @foreach (var region in _regions)
                    {
                        <option value="@region.Code">@region.DisplayName</option>
                    }
                </InputSelect>
                <ValidationMessage For="@(() => OrgData.CountryCode)" class="validation-message" />
            </div>

            <div class="form-group">
                <label class="form-label">State / Province</label>
                <InputText @bind-Value="OrgData.State" class="form-control" placeholder="South Australia" />
            </div>

            <div class="form-group">
                <label class="form-label">City</label>
                <InputText @bind-Value="OrgData.City" class="form-control" placeholder="Adelaide" />
            </div>

            <div class="form-group">
                <label class="form-label">Postal Code</label>
                <InputText @bind-Value="OrgData.PostalCode" class="form-control" placeholder="5000" />
            </div>

            <div class="stage-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandlePrevious">
                    <i class="bi bi-arrow-left"></i>
                    <span>Previous</span>
                </button>
                <button type="submit" class="btn btn-primary">
                    <span>Next</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public InitialSetupWizard.OrganizationData OrgData { get; set; } = new();
    [Parameter] public EventCallback<InitialSetupWizard.OrganizationData> OrgDataChanged { get; set; }

    private IReadOnlyList<OrganizationRegionalSettings.RegionOption> _regions = Array.Empty<OrganizationRegionalSettings.RegionOption>();

    protected override void OnInitialized()
    {
        _regions = OrganizationRegionalSettings.GetRegionOptions();
    }

    private async Task HandleNext()
    {
        if (!OrganizationRegionalSettings.TryGetRegion(OrgData.CountryCode, out var region) || region is null)
        {
            return;
        }

        OrgData.CountryCode = region.TwoLetterISORegionName;
        OrgData.Country = region.EnglishName;
        await OrgDataChanged.InvokeAsync(OrgData);
        await OnNext.InvokeAsync();
    }

    private async Task HandlePrevious()
    {
        await OnPrevious.InvokeAsync();
    }
}
