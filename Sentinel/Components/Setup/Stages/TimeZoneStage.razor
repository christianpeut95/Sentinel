@using Sentinel.Services

<div class="stage-card">
    <div class="stage-header">
        <h2><i class="bi bi-clock"></i> Regional Settings</h2>
        <p>Select the organisation time zone and display format used throughout Sentinel.</p>
    </div>

    <div class="stage-body">
        <EditForm Model="@this" OnValidSubmit="HandleNext">
            <div class="form-group">
                <label class="form-label required">Time Zone</label>
                <InputSelect @bind-Value="TimeZoneId" @bind-Value:after="TimeZoneSelectionChangedAsync" class="form-control">
                    <option value="">-- Select Time Zone --</option>
                    @foreach (var tz in _timeZones)
                    {
                        <option value="@tz.Id">@tz.DisplayName</option>
                    }
                </InputSelect>
                <span class="form-text">Timestamps are stored in UTC and displayed in this zone.</span>
            </div>

            <div class="form-group">
                <label class="form-label required">Date, Number and Language Format</label>
                <InputSelect @bind-Value="Locale" @bind-Value:after="LocaleSelectionChangedAsync" class="form-control">
                    <option value="">-- Select Format --</option>
                    @foreach (var locale in _locales)
                    {
                        <option value="@locale.Name">@locale.DisplayName</option>
                    }
                </InputSelect>
                <span class="form-text">Controls date and number formatting; it does not change patient language records.</span>
            </div>

            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                <strong>Current Selection:</strong> @(_selectedTimeZone?.DisplayName ?? "None")
                <br />
                <small>UTC Offset: @(_selectedTimeZone?.BaseUtcOffset.ToString() ?? "N/A")</small>
            </div>

            <div class="stage-actions">
                <button type="button" class="btn btn-secondary" @onclick="HandlePrevious">
                    <i class="bi bi-arrow-left"></i>
                    <span>Previous</span>
                </button>
                <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrEmpty(TimeZoneId) || string.IsNullOrEmpty(Locale))">
                    <span>Next</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public string TimeZoneId { get; set; } = OrganizationRegionalSettings.DefaultTimeZoneId;
    [Parameter] public EventCallback<string> TimeZoneIdChanged { get; set; }
    [Parameter] public string Locale { get; set; } = OrganizationRegionalSettings.DefaultLocale;
    [Parameter] public EventCallback<string> LocaleChanged { get; set; }

    private IReadOnlyList<OrganizationRegionalSettings.TimeZoneOption> _timeZones = Array.Empty<OrganizationRegionalSettings.TimeZoneOption>();
    private IReadOnlyList<OrganizationRegionalSettings.LocaleOption> _locales = Array.Empty<OrganizationRegionalSettings.LocaleOption>();
    private TimeZoneInfo? _selectedTimeZone;

    protected override void OnInitialized()
    {
        _timeZones = OrganizationRegionalSettings.GetTimeZoneOptions();
        _locales = OrganizationRegionalSettings.GetLocaleOptions();

        UpdateSelectedTimeZone();
    }

    protected override void OnParametersSet()
    {
        UpdateSelectedTimeZone();
    }

    private void UpdateSelectedTimeZone()
    {
        _selectedTimeZone = null;

        if (!string.IsNullOrWhiteSpace(TimeZoneId)
            && OrganizationRegionalSettings.TryResolveTimeZone(TimeZoneId, out var selectedTimeZone))
        {
            _selectedTimeZone = selectedTimeZone;
        }
    }

    private async Task HandleNext()
    {
        if (!OrganizationRegionalSettings.TryResolveTimeZone(TimeZoneId, out var timeZone)
            || !OrganizationRegionalSettings.TryGetCulture(Locale, out var culture))
        {
            return;
        }

        await OnNext.InvokeAsync();
    }

    private async Task TimeZoneSelectionChangedAsync()
    {
        UpdateSelectedTimeZone();

        if (OrganizationRegionalSettings.TryResolveTimeZone(TimeZoneId, out var timeZone))
        {
            await TimeZoneIdChanged.InvokeAsync(OrganizationRegionalSettings.GetCanonicalTimeZoneId(timeZone));
        }
    }

    private async Task LocaleSelectionChangedAsync()
    {
        if (OrganizationRegionalSettings.TryGetCulture(Locale, out var culture))
        {
            await LocaleChanged.InvokeAsync(culture.Name);
        }
    }

    private async Task HandlePrevious()
    {
        await OnPrevious.InvokeAsync();
    }
}
