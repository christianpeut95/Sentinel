# Environment variables for docker-compose
# Copy this to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# Docker Hub Configuration
DOCKERHUB_USERNAME=your-dockerhub-username
VERSION_TAG=latest

# Application Environment
ASPNETCORE_ENVIRONMENT=Production

# Public HTTPS hostname and ACME account email. Before starting the stack,
# point this hostname's DNS A/AAAA record to the Docker host and allow inbound
# TCP 80 and TCP/UDP 443 through the firewall.
SENTINEL_HOSTNAME=sentinel.example.org
ACME_EMAIL=admin@example.org

# Database Configuration
# Required. Generate two distinct strong values using only letters, digits and
# ! so they are safe in both the SQL bootstrap script and connection string:
# openssl rand -hex 32
# Append Aa1! to each generated value before saving it below.
# SQL_SA_PASSWORD is used only by SQL Server and the short-lived bootstrap job.
SQL_SA_PASSWORD=
# SQL_APP_PASSWORD is the password used by Sentinel's database-scoped login.
SQL_APP_PASSWORD=

# Geocoding Configuration
GEOCODING_PROVIDER=google
# Server-only key for Google Geocoding API v4 and Places API (New). Keep this
# out of browser code and restrict it to the server's egress IPs in Google Cloud.
GEOCODING_API_KEY=your-google-api-key-here
# Browser-visible key for Google Places autocomplete. Restrict it in Google
# Cloud by HTTPS referrer and to the Maps JavaScript/Places APIs it needs.
GOOGLE_MAPS_BROWSER_API_KEY=your-restricted-browser-api-key-here
GEOCODING_EMAIL=your-email@example.com
GEOCODING_DEFAULT_COUNTRY=AU

# Optional visual survey designer for an operator-managed demo deployment. The
# standard image does not include SurveyJS Creator. See
# docs/deployment/survey-designer.md before enabling the override.
# SURVEYJS_CREATOR_ASSETS_DIR=/absolute/path/to/surveyjs-creator-assets
