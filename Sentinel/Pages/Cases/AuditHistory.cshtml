@page
@model Sentinel.Pages.Cases.AuditHistoryModel
@using Sentinel.Models

@{
    ViewData["Title"] = "Audit History";
    Layout = "~/Pages/Shared/_LayoutSentinel.cshtml";
}
@functions {
    public string GetCspNonce()
    {
        if (HttpContext?.Items?.TryGetValue("csp-nonce", out var nonce) == true && nonce is string nonceStr)
        {
            return nonceStr;
        }
        return string.Empty;
    }
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        @if (Model.Case.Type == CaseType.Contact)
        {
            <li class="breadcrumb-item"><a asp-page="/Contacts/Index">Contacts</a></li>
            <li class="breadcrumb-item"><a asp-page="/Contacts/Details" asp-route-id="@Model.Case.Id">Details</a></li>
        }
        else
        {
            <li class="breadcrumb-item"><a asp-page="./Index">Cases</a></li>
            <li class="breadcrumb-item"><a asp-page="./Details" asp-route-id="@Model.Case.Id">Details</a></li>
        }
        <li class="breadcrumb-item active" aria-current="page">Audit History</li>
    </ol>
</nav>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-6); flex-wrap: wrap; gap: var(--spacing-3);">
    <h1 style="font-family: var(--f-sans); font-weight: 600; font-size: 28px; color: var(--slate); margin: 0; display: flex; align-items: center; gap: var(--spacing-3);">
        <i class="bi bi-clock-history"></i>
        Audit History
    </h1>
    @if (Model.Case.Type == CaseType.Contact)
    {
        <a asp-page="/Contacts/Details" asp-route-id="@Model.Case.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Contact
        </a>
    }
    else
    {
        <a asp-page="./Details" asp-route-id="@Model.Case.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Case
        </a>
    }
</div>

<div class="sentinel-card" style="margin-bottom: var(--spacing-6);">
    <div class="sentinel-card-body">
        <div class="row align-items-center g-2">
            <div class="col-12 col-md-4">
                <p class="mb-0" style="font-family: var(--f-sans); font-size: 14px; color: var(--graphite);">
                    <strong style="color: var(--slate);">@(Model.Case.Type == CaseType.Contact ? "Contact" : "Case") ID:</strong> @Model.Case.FriendlyId
                </p>
            </div>
            <div class="col-12 col-md-4 text-center">
                <span style="display: inline-block; padding: 6px 12px; background: var(--forest); color: white; border-radius: var(--radius-full); font-size: 13px; font-weight: 500; margin-right: var(--spacing-2);">
                    @Model.DataChangeCount data changes
                </span>
                <span style="display: inline-block; padding: 6px 12px; background: var(--info); color: white; border-radius: var(--radius-full); font-size: 13px; font-weight: 500;">
                    @Model.ViewCount views
                </span>
            </div>
            <div class="col-12 col-md-4 text-end">
                <form method="get" class="d-inline-block">
                    <input type="hidden" name="id" value="@Model.CaseId" />
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input" type="checkbox" id="showViewsToggle" 
                               name="showViews" value="true"
                               @(Model.ShowViews ? "checked" : "") 
                               onchange="this.form.submit()">
                        <label class="form-check-label" for="showViewsToggle">
                            Show View Events
                        </label>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.AuditLogs.Count == 0)
{
    <div class="sentinel-card">
        <div class="sentinel-card-body" style="text-align: center; padding: var(--spacing-12);">
            <i class="bi bi-clock-history" style="font-size: 64px; color: var(--hairline); display: block; margin-bottom: var(--spacing-4);"></i>
            <p style="color: var(--graphite); font-size: 15px;">No audit history found for this @(Model.Case.Type == CaseType.Contact ? "contact" : "case").</p>
        </div>
    </div>
}
else
{
    <div class="sentinel-card">
        <div class="sentinel-card-body">
            <div class="timeline">
                @{
                    DateTime? lastDate = null;
                    foreach (var log in Model.AuditLogs)
                    {
                        var currentDate = log.ChangedAt.Date;
                        if (lastDate == null || lastDate != currentDate)
                        {
                            <div class="timeline-date">
                                <div style="font-family: var(--f-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--graphite); display: flex; align-items: center; gap: var(--spacing-2);">
                                    <i class="bi bi-calendar3"></i>
                                    @log.ChangedAt.ToString("dddd, dd MMMM yyyy")
                                </div>
                            </div>
                            lastDate = currentDate;
                        }

                        var actionColor = log.Action switch
                        {
                            "Added" => "var(--signal-dk)",
                            "Modified" => "var(--info)",
                            "Deleted" => "var(--status-outbreak)",
                            "Viewed" => "var(--graphite)",
                            _ => "var(--slate)"
                        };

                        var actionIcon = log.Action switch
                        {
                            "Added" => "plus-circle",
                            "Modified" => "pencil",
                            "Deleted" => "trash",
                            "Viewed" => "eye",
                            _ => "question-circle"
                        };

                        <div class="timeline-item @(log.Action == "Viewed" ? "timeline-item-view" : "")" style="opacity: @(log.Action == "Viewed" ? "0.7" : "1");">
                            <div class="timeline-marker" style="background: @actionColor;">
                                <i class="bi bi-@actionIcon"></i>
                            </div>
                            <div class="timeline-content">
                                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: var(--spacing-3); gap: var(--spacing-3);">
                                    <div>
                                        <span style="display: inline-block; padding: 4px 10px; background: @actionColor; color: white; border-radius: var(--radius-full); font-size: 12px; font-weight: 500; margin-right: var(--spacing-2);">
                                            @log.Action
                                        </span>
                                        @if (log.Action == "Viewed")
                                        {
                                            <strong style="font-family: var(--f-sans); font-size: 14px; color: var(--slate);">Record Viewed</strong>
                                        }
                                        else
                                        {
                                            <strong style="font-family: var(--f-sans); font-size: 14px; color: var(--slate);">@log.FieldName</strong>
                                        }
                                    </div>
                                    <small style="color: var(--graphite); font-family: var(--f-mono); font-size: 13px; white-space: nowrap;">
                                        @log.ChangedAt.ToString("HH:mm:ss")
                                    </small>
                                </div>

                                <div style="margin-bottom: var(--spacing-3);">
                                    @if (log.Action == "Viewed")
                                    {
                                        <div style="background: var(--mesh); border: 1px solid var(--hairline); border-radius: var(--radius-md); padding: var(--spacing-3); font-size: 14px; color: var(--graphite);">
                                            <i class="bi bi-eye me-2"></i>@(Model.Case.Type == CaseType.Contact ? "Contact" : "Case") record was accessed
                                        </div>
                                    }
                                    else if (log.Action == "Added")
                                    {
                                        <div style="background: color-mix(in srgb, var(--signal) 10%, transparent); border: 1px solid var(--signal); border-radius: var(--radius-md); padding: var(--spacing-3); font-size: 14px;">
                                            <strong style="color: var(--slate);">Value:</strong> <span style="color: var(--graphite);">@(string.IsNullOrWhiteSpace(log.NewValue) ? "(empty)" : log.NewValue)</span>
                                        </div>
                                    }
                                    else if (log.Action == "Deleted")
                                    {
                                        <div style="background: color-mix(in srgb, var(--status-outbreak) 10%, transparent); border: 1px solid var(--status-outbreak); border-radius: var(--radius-md); padding: var(--spacing-3); font-size: 14px;">
                                            <strong style="color: var(--slate);">Value:</strong> <span style="color: var(--graphite);">@(string.IsNullOrWhiteSpace(log.OldValue) ? "(empty)" : log.OldValue)</span>
                                        </div>
                                    }
                                    else if (log.Action == "Modified")
                                    {
                                        <div class="row g-2">
                                            <div class="col-md-6">
                                                <div style="background: color-mix(in srgb, var(--status-alert) 10%, transparent); border: 1px solid var(--status-alert); border-radius: var(--radius-md); padding: var(--spacing-3); font-size: 14px;">
                                                    <strong style="color: var(--slate);">Old:</strong> <span style="color: var(--graphite);">@(string.IsNullOrWhiteSpace(log.OldValue) ? "(empty)" : log.OldValue)</span>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div style="background: color-mix(in srgb, var(--signal) 10%, transparent); border: 1px solid var(--signal); border-radius: var(--radius-md); padding: var(--spacing-3); font-size: 14px;">
                                                    <strong style="color: var(--slate);">New:</strong> <span style="color: var(--graphite);">@(string.IsNullOrWhiteSpace(log.NewValue) ? "(empty)" : log.NewValue)</span>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div style="color: var(--graphite); font-size: 13px;">
                                    <i class="bi bi-person me-1"></i>
                                    @if (log.Action == "Viewed")
                                    {
                                        <text>Viewed by:</text>
                                    }
                                    else
                                    {
                                        <text>Changed by:</text>
                                    }
                                    <strong style="color: var(--slate);">@(log.ChangedByUser?.Email ?? log.ChangedByUserId ?? "System")</strong>
                                    @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                    {
                                        <span class="ms-2">
                                            <i class="bi bi-globe me-1"></i>IP: @log.IpAddress
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@section Styles {
<style>
    .timeline {
        position: relative;
        padding: var(--spacing-4) 0;
    }

    .timeline-date {
        margin: var(--spacing-6) 0 var(--spacing-4) 0;
    }

    .timeline-date:first-child {
        margin-top: 0;
    }

    .timeline-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: var(--spacing-6);
        border-left: 2px solid var(--hairline);
        margin-left: 20px;
    }

    .timeline-item:last-child {
        border-left: 2px solid transparent;
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -21px;
        top: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.1rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }

    .timeline-content {
        background: var(--mesh);
        padding: var(--spacing-4);
        border-radius: var(--radius-lg);
        border: 1px solid var(--hairline);
    }

    @@media (max-width: 768px) {
        .timeline-item {
            padding-left: 50px;
            margin-left: 15px;
        }

        .timeline-marker {
            left: -18px;
            width: 35px;
            height: 35px;
            font-size: 1rem;
        }

        .timeline-content {
            padding: var(--spacing-3);
        }
    }
</style>
}
    /* Ensure cards don't overflow */
    .card {
        max-width: 100%;
        min-width: 0;
    }

    .card-body {
        overflow-x: auto;
        min-width: 0;
    }

    /* Make row responsive */
    .row {
        --bs-gutter-x: 1rem;
    }

    /* Ensure long text wraps */
    strong {
        word-break: break-word;
    }

    /* Make badges wrap on small screens */
    .badge {
        white-space: normal;
        word-break: break-word;
    }
</style>
