@page
@model Sentinel.Pages.Patients.AuditHistoryModel

@{
    ViewData["Title"] = "Audit History";
    Layout = "~/Pages/Shared/_LayoutSentinel.cshtml";
}
@functions {
    public string GetCspNonce()
    {
        if (HttpContext?.Items?.TryGetValue("csp-nonce", out var nonce) == true && nonce is string nonceStr)
        {
            return nonceStr;
        }
        return string.Empty;
    }
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Patients</a></li>
        <li class="breadcrumb-item"><a asp-page="./Details" asp-route-id="@Model.PatientId">Details</a></li>
        <li class="breadcrumb-item active" aria-current="page">Audit History</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
    <h2 class="mb-0"><i class="bi bi-clock-history me-2"></i>Audit History</h2>
    <a asp-page="./Details" asp-route-id="@Model.PatientId" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Patient
    </a>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="row align-items-center g-2">
            <div class="col-12 col-md-4">
                <p class="mb-0">
                    <strong>Patient ID:</strong> @Model.PatientId
                </p>
            </div>
            <div class="col-12 col-md-4 text-center">
                <span class="badge bg-primary me-2">@Model.DataChangeCount data changes</span>
                <span class="badge bg-info">@Model.ViewCount views</span>
            </div>
            <div class="col-12 col-md-4 text-end">
                <form method="get" class="d-inline-block">
                    <input type="hidden" name="id" value="@Model.PatientId" />
                    <div class="form-check form-switch d-inline-block">
                        <input class="form-check-input" type="checkbox" id="showViewsToggle" 
                               name="showViews" value="true"
                               @(Model.ShowViews ? "checked" : "") 
                               onchange="this.form.submit()">
                        <label class="form-check-label" for="showViewsToggle">
                            Show View Events
                        </label>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@if (Model.AuditLogs.Count == 0)
{
    <div class="sentinel-card">
        <div class="sentinel-card-body" style="text-align: center; padding: var(--spacing-12);">
            <i class="bi bi-clock-history" style="font-size: 64px; color: var(--hairline); display: block; margin-bottom: var(--spacing-4);"></i>
            <p style="color: var(--graphite); font-size: 15px;">No audit history found for this patient.</p>
        </div>
    </div>
}
else
{
    <div class="sentinel-card">
        <div class="sentinel-card-body">
            <div class="timeline">
                @{
                    DateTime? lastDate = null;
                    foreach (var log in Model.AuditLogs)
                    {
                        var currentDate = log.ChangedAt.Date;
                        if (lastDate == null || lastDate != currentDate)
                        {
                            <div class="timeline-date">
                                <div style="font-family: var(--f-mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--graphite); display: flex; align-items: center; gap: var(--spacing-2);">
                                    <i class="bi bi-calendar3"></i>
                                    @log.ChangedAt.ToString("dddd, dd MMMM yyyy")
                                </div>
                            </div>
                            lastDate = currentDate;
                        }

                        var actionColor = log.Action switch
                        {
                            "Added" => "var(--signal-dk)",
                            "Modified" => "var(--info)",
                            "Deleted" => "var(--status-outbreak)",
                            "Viewed" => "var(--graphite)",
                            _ => "var(--slate)"
                        };

                        var actionIcon = log.Action switch
                        {
                            "Added" => "plus-circle-fill",
                            "Modified" => "pencil-fill",
                            "Deleted" => "trash-fill",
                            "Viewed" => "eye-fill",
                            _ => "question-circle-fill"
                        };

                        var isViewEvent = log.Action == "Viewed";
                        var formattedFieldName = Model.FormatFieldName(log.FieldName);
                        var formattedOldValue = Model.FormatFieldValue(log.FieldName, log.OldValue);
                        var formattedNewValue = Model.FormatFieldValue(log.FieldName, log.NewValue);

                        <div class="timeline-item @(isViewEvent ? "timeline-item-view" : "")" style="@(isViewEvent ? "opacity: 0.7;" : "")">
                            <div class="timeline-marker" style="background: @actionColor;">
                                <i class="bi bi-@actionIcon"></i>
                            </div>
                            <div class="timeline-content">
                                <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: var(--spacing-3); gap: var(--spacing-3);">
                                    <div style="display: flex; align-items: center; gap: var(--spacing-2); flex-wrap: wrap;">
                                        <span class="chip-clear" style="background: @actionColor; color: var(--chalk); border: none; font-size: 10px; padding: 3px 10px;">
                                            @log.Action
                                        </span>
                                        @if (isViewEvent)
                                        {
                                            <strong style="font-size: 15px; color: var(--forest);">Record Viewed</strong>
                                        }
                                        else
                                        {
                                            <strong style="font-size: 15px; color: var(--forest);">@formattedFieldName</strong>
                                        }
                                    </div>
                                    <small style="font-family: var(--f-mono); font-size: 11px; color: var(--graphite); white-space: nowrap;">
                                        @log.ChangedAt.ToLocalTime().ToString("HH:mm:ss")
                                    </small>
                                </div>

                                <div style="margin-bottom: var(--spacing-3);">
                                    @if (isViewEvent)
                                    {
                                        <div style="background: var(--signal-lt); border-left: 3px solid var(--info); padding: var(--spacing-3); border-radius: var(--radius-md); font-size: 13px; color: var(--forest);">
                                            <i class="bi bi-eye me-2"></i>Patient record was accessed
                                        </div>
                                    }
                                    else if (log.Action == "Added")
                                    {
                                        <div style="background: var(--signal-lt); border-left: 3px solid var(--signal-dk); padding: var(--spacing-3); border-radius: var(--radius-md);">
                                            <div style="font-size: 11px; font-family: var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--graphite); margin-bottom: var(--spacing-1);">Value</div>
                                            <div style="font-size: 14px; color: var(--forest); font-weight: 500;">@(string.IsNullOrWhiteSpace(formattedNewValue) ? "(empty)" : formattedNewValue)</div>
                                        </div>
                                    }
                                    else if (log.Action == "Deleted")
                                    {
                                        <div style="background: #FBE2D8; border-left: 3px solid var(--status-outbreak); padding: var(--spacing-3); border-radius: var(--radius-md);">
                                            <div style="font-size: 11px; font-family: var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--graphite); margin-bottom: var(--spacing-1);">Removed Value</div>
                                            <div style="font-size: 14px; color: var(--forest); font-weight: 500; text-decoration: line-through;">@(string.IsNullOrWhiteSpace(formattedOldValue) ? "(empty)" : formattedOldValue)</div>
                                        </div>
                                    }
                                    else if (log.Action == "Modified")
                                    {
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--spacing-3);">
                                            <div style="background: #FBEDD1; border-left: 3px solid var(--watch); padding: var(--spacing-3); border-radius: var(--radius-md);">
                                                <div style="font-size: 11px; font-family: var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--graphite); margin-bottom: var(--spacing-1);">Previous</div>
                                                <div style="font-size: 14px; color: var(--forest);">@(string.IsNullOrWhiteSpace(formattedOldValue) ? "(empty)" : formattedOldValue)</div>
                                            </div>
                                            <div style="background: var(--signal-lt); border-left: 3px solid var(--signal-dk); padding: var(--spacing-3); border-radius: var(--radius-md);">
                                                <div style="font-size: 11px; font-family: var(--f-mono); letter-spacing: .04em; text-transform: uppercase; color: var(--graphite); margin-bottom: var(--spacing-1);">Current</div>
                                                <div style="font-size: 14px; color: var(--forest); font-weight: 500;">@(string.IsNullOrWhiteSpace(formattedNewValue) ? "(empty)" : formattedNewValue)</div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div style="font-size: 13px; color: var(--graphite); display: flex; align-items: center; gap: var(--spacing-4); flex-wrap: wrap;">
                                    <span>
                                        <i class="bi bi-person me-1"></i>
                                        @if (isViewEvent)
                                        {
                                            <text>Viewed by:</text>
                                        }
                                        else
                                        {
                                            <text>Changed by:</text>
                                        }
                                        <strong style="color: var(--forest); margin-left: 4px;">@(log.ChangedByUser?.Email ?? log.ChangedByUserId ?? "System")</strong>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(log.IpAddress))
                                    {
                                        <span style="font-family: var(--f-mono); font-size: 11px;">
                                            <i class="bi bi-globe me-1"></i>@log.IpAddress
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@section Styles {
<style>
    .timeline {
        position: relative;
        padding: var(--spacing-4) 0;
    }

    .timeline-date {
        margin: var(--spacing-8) 0 var(--spacing-4) 0;
        padding-bottom: var(--spacing-3);
        border-bottom: 1px solid var(--hairline);
    }

    .timeline-date:first-child {
        margin-top: 0;
    }

    .timeline-item {
        position: relative;
        padding-left: 60px;
        padding-bottom: var(--spacing-6);
        border-left: 2px solid var(--hairline);
        margin-left: 20px;
    }

    .timeline-item:last-child {
        border-left: 2px solid transparent;
        padding-bottom: 0;
    }

    .timeline-marker {
        position: absolute;
        left: -21px;
        top: 0;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--chalk);
        font-size: 16px;
        box-shadow: var(--shadow-md);
    }

    .timeline-content {
        background: var(--chalk);
        padding: var(--spacing-4);
        border-radius: var(--radius-md);
        border: 1px solid var(--hairline);
    }

    .timeline-item-view .timeline-content {
        background: var(--bone);
    }

    @@media (max-width: 768px) {
        .timeline-content > div[style*="grid-template-columns"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>
}
