@page
@model Sentinel.Pages.Reports.WebDataRocksTermsModel
@using Sentinel.Services

@{
    ViewData["Title"] = "Interactive Report Terms";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-page="/Reports/Index">Reports</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Interactive Report Terms</li>
                </ol>
            </nav>

            <div class="card shadow-sm">
                <div class="card-header bg-white">
                    <h3 class="mb-1"><i class="bi bi-file-earmark-text me-2"></i>Interactive Report Terms</h3>
                    <p class="text-muted mb-0">WebDataRocks is an optional, separately licensed component.</p>
                </div>
                <div class="card-body">
                    @if (!Model.LicenseStatus.OrganizationAccepted)
                    {
                        <div class="alert alert-warning mb-0">
                            <h5><i class="bi bi-slash-circle me-1"></i>Interactive pivot reports are not enabled</h5>
                            <p class="mb-0">An organisation administrator must enable the feature and accept the current WebDataRocks Licence Agreement in <a asp-page="/Settings/InteractiveReports">Interactive Reports settings</a>. Standard report tables remain available.</p>
                        </div>
                    }
                    else
                    {
                        <p>Before Sentinel loads WebDataRocks in your browser, you must accept the current vendor agreement. The component is governed by that agreement, not by the Sentinel GPL licence.</p>
                        <ul>
                            <li><a href="@WebDataRocksLicenseService.LicenseUrl" target="_blank" rel="noopener noreferrer">Read the WebDataRocks Licence Agreement</a> (revision @WebDataRocksLicenseService.CurrentLicenseVersion).</li>
                            <li>Vendor attribution and the component’s applicable usage limits remain in effect.</li>
                            <li>Sentinel loads the component from the vendor CDN only after this acceptance is recorded.</li>
                        </ul>

                        <form method="post">
                            <input type="hidden" asp-for="ReturnUrl" />
                            <div class="form-check border rounded p-3 mb-3 bg-light">
                                <input asp-for="AcceptLicenseTerms" class="form-check-input" />
                                <label asp-for="AcceptLicenseTerms" class="form-check-label">
                                    I have read and accept the WebDataRocks Licence Agreement for my use of Sentinel’s interactive pivot reporting.
                                </label>
                                <span asp-validation-for="AcceptLicenseTerms" class="text-danger d-block mt-2"></span>
                            </div>
                            <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle me-1"></i>Accept and Continue</button>
                            <a asp-page="/Reports/Index" class="btn btn-outline-secondary ms-2">Return to Reports</a>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
