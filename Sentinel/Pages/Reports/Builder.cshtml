@page
@model Sentinel.Pages.Reports.BuilderModel
@{
    ViewData["Title"] = Model.ReportId.HasValue ? "Edit Report" : "Report Builder";
    Layout = null;
}
@functions {
    public string GetCspNonce()
    {
        if (HttpContext?.Items?.TryGetValue("csp-nonce", out var nonce) == true && nonce is string nonceStr)
        {
            return nonceStr;
        }
        return string.Empty;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sentinel</title>
    <link href="https://cdn.webdatarocks.com/latest/webdatarocks.css" rel="stylesheet" />
    <link href="~/css/report-builder-compact.css" rel="stylesheet" />
</head>
<body>

<!-- Loading Overlay -->
<div id="report-loading-overlay" class="rb-loading-overlay hidden">
    <div class="rb-loading-content">
        <div class="rb-loading-spinner"></div>
        <div class="rb-loading-text">Loading Report</div>
        <div class="rb-loading-subtext">Restoring filters and collection queries...</div>
        <div class="rb-loading-progress" id="loading-progress"></div>
    </div>
</div>

<!-- Main Window -->
<div class="rb-window">
    <!-- Title Bar -->
    <div class="rb-title-bar">
        <div class="rb-title-text">
            <span>Sentinel Report Builder</span>
            @if (Model.ReportId.HasValue)
            {
                <span class="rb-text-muted">— Edit Mode</span>
            }
        </div>
        <div class="rb-title-actions">
            <button type="button" class="rb-toolbar-btn" id="btnBack">
                ← Back to Reports
            </button>
        </div>
    </div>

    <!-- Main Layout -->
    <div class="rb-main-layout">
        <!-- Left Panel (Narrow) -->
        <div class="rb-left-panel">
            <!-- Report Details Section -->
            <div class="rb-panel-section">
                <div class="rb-panel-header">
                    <span>Report Details</span>
                </div>
                <div class="rb-panel-body">
                    <div class="rb-sidebar-field">
                            <label class="rb-info-label" for="reportName">Name</label>
                        <input class="rb-collection-input" type="text" id="reportName"
                               placeholder="Enter report name..."
                               value="@Model.ReportDefinition?.Name">
                    </div>
                    <div class="rb-sidebar-field">
                        <label class="rb-info-label" for="reportDescription">Description</label>
                        <textarea class= "rb-collection-input" id="reportDescription"
                                  rows="3"
                                  placeholder="Enter report description...">@Model.ReportDefinition?.Description</textarea>
                    </div>
                    <div class="rb-sidebar-field">
                        <label for="reportCategory">Category</label>
                        <select id="reportCategory">
                            <option value="">Select category...</option>
                            <option value="Operational" selected="@(Model.ReportDefinition?.Category == "Operational")">Operational</option>
                            <option value="Surveillance" selected="@(Model.ReportDefinition?.Category == "Surveillance")">Surveillance</option>
                            <option value="Epidemiological" selected="@(Model.ReportDefinition?.Category == "Epidemiological")">Epidemiological</option>
                            <option value="Administrative" selected="@(Model.ReportDefinition?.Category == "Administrative")">Administrative</option>
                            <option value="Custom" selected="@(Model.ReportDefinition?.Category == "Custom")">Custom</option>
                        </select>
                    </div>
                    <label class="rb-sidebar-checkbox" for="reportPublic">
                        <input type="checkbox" id="reportPublic"
                               checked="@(Model.ReportDefinition?.IsPublic ?? false)">
                        <span>Public report</span>
                    </label>
                    <div class="rb-sidebar-actions">
                        <button type="button" class="rb-toolbar-btn" id="btnPreview">Refresh Preview</button>
                        <button type="button" class="rb-toolbar-btn primary" id="btnSave">Save Report</button>
                    </div>
                </div>
            </div>

            <!-- Audit Information Section -->
            <div class="rb-panel-section">
                <div class="rb-panel-header">
                    <span>History</span>
                </div>
                <div class="rb-panel-body rb-audit-list">
                    <div class="rb-audit-row">
                        <span class="rb-audit-label">Created by</span>
                        <span class="rb-audit-value">@Model.CreatedByDisplayName</span>
                    </div>
                    <div class="rb-audit-row">
                        <span class="rb-audit-label">Created</span>
                        @if (Model.ReportDefinition != null)
                        {
                            <time class="rb-audit-value js-local-time"
                                  datetime="@Model.ReportDefinition.CreatedAt.ToString("O")">
                                @Model.ReportDefinition.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC
                            </time>
                        }
                        else
                        {
                            <span class="rb-audit-value">After first save</span>
                        }
                    </div>
                    <div class="rb-audit-row">
                        <span class="rb-info-label">Last changed by</span>
                        <span class="rb-audit-value">@Model.ModifiedByDisplayName</span>
                    </div>
                    <div class="rb-audit-row">
                        <span class="rb-audit-label">Last changed</span>
                        @if (Model.ReportDefinition != null)
                        {
                            var lastChangedAt = Model.ReportDefinition.ModifiedAt ?? Model.ReportDefinition.CreatedAt;
                            <time class="rb-audit-value js-local-time"
                                  datetime="@lastChangedAt.ToString("O")">
                                @lastChangedAt.ToString("dd MMM yyyy, HH:mm") UTC
                            </time>
                        }
                        else
                        {
                            <span class="rb-audit-value">Not yet saved</span>
                        }
                    </div>
                    <div class="rb-audit-row">
                        <span class="rb-audit-label">Last run</span>
                        @if (Model.ReportDefinition?.LastRunDate != null)
                        {
                            <time class="rb-audit-value js-local-time"
                                  datetime="@Model.ReportDefinition.LastRunDate.Value.ToString("O")">
                                @Model.ReportDefinition.LastRunDate.Value.ToString("dd MMM yyyy, HH:mm") UTC
                            </time>
                        }
                        else
                        {
                            <span class="rb-audit-value">Never</span>
                        }
                    </div>
                    <div class="rb-audit-row">
                        <span class="rb-audit-label">Run count</span>
                        <span class="rb-audit-value">@(Model.ReportDefinition?.RunCount ?? 0)</span>
                    </div>
                </div>
            </div>

            <!-- Report Info Section -->
            <div class="rb-panel-section">
                <div class="rb-panel-header">
                    <span>Report Info</span>
                </div>
                <div class="rb-panel-body">
                    <div class="rb-info-group">
                        <div class="rb-info-label">Entity Type</div>
                        <div class="rb-info-value">
                            <select class="rb-entity-selector" id="entityTypeSelector">
                                <optgroup label="Core Entities">
                                    <option value="Case" selected="@(Model.EntityType == "Case")">Cases</option>
                                    <option value="Contact" selected="@(Model.EntityType == "Contact")">Contacts</option>
                                    <option value="Outbreak" selected="@(Model.EntityType == "Outbreak")">Outbreaks</option>
                                    <option value="Patient" selected="@(Model.EntityType == "Patient")">Patients</option>
                                    <option value="Task" selected="@(Model.EntityType == "Task")">Tasks</option>
                                    <option value="Location" selected="@(Model.EntityType == "Location")">Locations</option>
                                    <option value="Event" selected="@(Model.EntityType == "Event")">Events</option>
                                </optgroup>
                                <optgroup label="Flattened Views">
                                    <option value="CaseContactTasksFlattened" selected="@(Model.EntityType == "CaseContactTasksFlattened")">Case Tasks + Transmission Chains</option>
                                    <option value="OutbreakTasksFlattened" selected="@(Model.EntityType == "OutbreakTasksFlattened")">Outbreak Tasks</option>
                                    <option value="ContactsListSimple" selected="@(Model.EntityType == "ContactsListSimple")">Contacts List</option>
                                </optgroup>
                            </select>
                        </div>
                    </div>
                    <div class="rb-info-group">
                        <div class="rb-info-label">Record Count</div>
                        <div class="rb-info-value highlight" id="recordCount">—</div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions Section -->
            <div class="rb-panel-section">
                <div class="rb-panel-header">
                    <span>Quick Actions</span>
                </div>
                <div class="rb-panel-body">
                    <button type="button" class="rb-task-link" id="btnAddFields">▸ Add Fields</button>
                    <button type="button" class="rb-task-link" id="btnAddFilter">▸ Add Filter</button>
                    <button type="button" class="rb-task-link" id="btnAddCollection">▸ Add Collection Query</button>
                    <button type="button" class="rb-task-link" id="btnLoadDefaults">▸ Load Default Fields</button>
                    <button type="button" class="rb-task-link" id="btnClearAll">▸ Clear All</button>
                </div>
            </div>

            <!-- Query Summary Section -->
            <div class="rb-panel-section">
                <div class="rb-panel-header">
                    <span>Query Summary</span>
                </div>
                <div class="rb-panel-body">
                    <div class="rb-query-box" id="querySummary">
                        <span class="kw">SELECT</span> <span class="val">*</span>
                        <span class="kw">FROM</span> <span class="val">Cases</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="rb-content-area">
            <!-- Tab Strip -->
            <div class="rb-tab-strip">
                <div class="rb-tab active" data-tab="configure">
                    <span>Configure</span>
                </div>
                <div class="rb-tab" data-tab="pivot">
                    <span>Pivot</span>
                </div>
            </div>

            <!-- Tab 1: Configure (Split View) -->
            <div class="rb-tab-content active" id="tabConfigure">
                <div class="rb-split-view">
                    <!-- Left Pane: Filters, Collections & Fields -->
                    <div class="rb-split-pane">
                        <div class="rb-pane-toolbar">
                            <span>Filters & Display Fields</span>
                            <span class="rb-text-muted"><span id="filterCount">0</span> filters · <span id="collectionCount">0</span> queries · <span id="fieldCount">0</span> fields</span>
                        </div>
                        <div class="rb-pane-content">
                            <!-- Filters Section -->
                            <div class="rb-section-header" style="display: flex; justify-content: space-between; align-items: center;">
                                <span>Filters</span>
                                <button type="button" class="rb-section-add-btn" id="btnAddFilterInline" title="Add Filter">+ Add</button>
                            </div>
                            <div class="rb-list-view" id="filters">
                                <div class="rb-empty-state">
                                    <div class="rb-empty-state-text">No filters applied</div>
                                </div>
                            </div>

                            <!-- Collection Queries Section -->
                            <div class="rb-section-header" style="margin-top: 16px; display: flex; justify-content: space-between; align-items: center;">
                                <span>Collection Queries</span>
                                <button type="button" class="rb-section-add-btn" id="btnAddCollectionInline" title="Add Collection Query">+ Add</button>
                            </div>
                            <div class="rb-list-view" id="collectionQueries">
                                <div class="rb-empty-state">
                                    <div class="rb-empty-state-text">No collection queries</div>
                                </div>
                            </div>

                            <!-- Display Fields Section -->
                            <div class="rb-section-header" style="margin-top: 16px;">Display Fields</div>
                            <div class="rb-list-view" id="selectedFields">
                                <div class="rb-empty-state">
                                    <div class="rb-empty-state-text">No fields selected</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Pane: Data Preview -->
                    <div class="rb-split-pane">
                        <div class="rb-pane-toolbar">
                            <span>Data Preview <span class="rb-text-muted" id="previewRecordCount"></span></span>
                            <div class="rb-toolbar-actions">
                                <button type="button" class="rb-toolbar-btn" id="btnRefreshPreview">Refresh</button>
                                <button type="button" class="rb-toolbar-btn" id="btnExportPreview">Export</button>
                            </div>
                        </div>
                        <div class="rb-pane-content no-padding">
                            <div class="rb-data-grid">
                                <div class="rb-grid-wrapper" id="previewContainer">
                                    <div class="rb-empty-state">
                                        <div class="rb-empty-state-title">No Preview Data</div>
                                        <div class="rb-empty-state-text">Select fields and filters, then click Refresh to preview data</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Tab 2: Pivot Analysis -->
            <div class="rb-tab-content" id="tabPivot">
                <div class="rb-pane-toolbar">
                    <span>Pivot Analysis <span class="rb-text-muted" id="pivotRecordCount"></span></span>
                    <div class="rb-toolbar-actions">
                        <button type="button" class="rb-toolbar-btn" id="btnRefreshPivot">Refresh</button>
                        <button type="button" class="rb-toolbar-btn" id="btnExportPivot">Export</button>
                    </div>
                </div>
                <div class="rb-pane-content no-padding">
                    <div id="wdr-pivot" class="wdr-pivot-container">
                        <div id="wdr-pivot-grid"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Bar -->
    <div class="rb-status-bar">
        <div class="rb-status-item">
            <span class="rb-status-label">Entity:</span>
            <span id="statusEntity">Cases</span>
        </div>
        <div class="rb-status-item">
            <span class="rb-status-label">Fields:</span>
            <span id="statusFields">0</span>
        </div>
        <div class="rb-status-item">
            <span class="rb-status-label">Filters:</span>
            <span id="statusFilters">0</span>
        </div>
        <div class="rb-status-item">
            <span class="rb-status-label">Collections:</span>
            <span id="statusCollections">0</span>
        </div>
        <div class="rb-status-item" style="margin-left: auto;">
            <span id="autoSaveStatus" style="opacity: 0.6; font-size: 0.85em;">Auto-save enabled</span>
        </div>
    </div>
</div>

<!-- Field Browser Modal -->
<div id="fieldBrowserModal" class="rb-modal hidden">
    <div class="rb-modal-backdrop"></div>
    <div class="rb-modal-content">
        <div class="rb-modal-header">
            <span>Available Fields</span>
            <button type="button" class="rb-modal-close" id="btnCloseFieldBrowser">×</button>
        </div>
        <div class="rb-modal-body">
            <input type="text" id="fieldSearch" placeholder="Search fields..." class="rb-search-input">
            <div class="rb-field-browser" id="fieldCategories">
                <!-- Field categories will be loaded here -->
            </div>
        </div>
    </div>
</div>

<!-- Scripts -->
<script src="https://cdn.webdatarocks.com/latest/webdatarocks.js"></script>
<script src="~/js/webdatarocks-helper.js?v=@DateTime.UtcNow.Ticks"></script>
<script src="~/js/webdatarocks-debug.js?v=@DateTime.UtcNow.Ticks"></script>
<script src="~/js/report-builder-notifications.js?v=@DateTime.UtcNow.Ticks"></script>
<script src="~/js/report-builder.js?v=@DateTime.UtcNow.Ticks"></script>
<script src="~/js/report-builder-collections.js?v=@DateTime.UtcNow.Ticks"></script>
<script src="~/js/report-builder-actions.js?v=@DateTime.UtcNow.Ticks"></script>
<script nonce="@GetCspNonce()">
    document.addEventListener('DOMContentLoaded', function() {
        console.log('🚀 Initializing Report Builder...');

        // Initialize WebDataRocks modal positioning fix
        if (window.webDataRocksHelper && typeof window.webDataRocksHelper.fixModalPositioning === 'function') {
            window.webDataRocksHelper.fixModalPositioning();
            console.log('✅ WebDataRocks modal positioning fix initialized');
        }

        // Initialize with saved report data
        const savedReport = {
            fields: JSON.parse(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FieldsJson ?? "[]"))),
            filters: JSON.parse(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.FiltersJson ?? "[]"))),
            collectionQueries: JSON.parse(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CollectionQueriesJson ?? "[]"))),
            entityType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EntityType)),
            reportId: @(Model.ReportId?.ToString() ?? "null"),
            reportName: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportDefinition?.Name)),
            reportDescription: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReportDefinition?.Description)),
            pivotConfiguration: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PivotConfigurationJson)),
            previewConfiguration: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PreviewConfigurationJson))
        };

        console.log('📦 Saved report data:', savedReport);

        // Initialize the report builder
        if (typeof ReportBuilder !== 'undefined') {
            ReportBuilder.init(savedReport);
            console.log('✅ ReportBuilder initialized');
        } else {
            console.error('❌ ReportBuilder not found!');
        }

        // Tab switching
        document.querySelectorAll('.rb-tab').forEach(tab => {
            tab.addEventListener('click', function() {
                const targetTab = this.getAttribute('data-tab');
                console.log('🔄 Switching to tab:', targetTab);

                // Update active states
                document.querySelectorAll('.rb-tab').forEach(t => t.classList.remove('active'));
                document.querySelectorAll('.rb-tab-content').forEach(c => c.classList.remove('active'));

                this.classList.add('active');
                const content = document.getElementById('tab' + targetTab.charAt(0).toUpperCase() + targetTab.slice(1));
                if (content) {
                    content.classList.add('active');
                }
            });
        });

        // Back button
        const btnBack = document.getElementById('btnBack');
        if (btnBack) {
            btnBack.addEventListener('click', () => {
                window.location.href = '/Reports';
            });
        }

        // Field browser modal
        const btnAddFields = document.getElementById('btnAddFields');
        const fieldBrowserModal = document.getElementById('fieldBrowserModal');
        const btnCloseFieldBrowser = document.getElementById('btnCloseFieldBrowser');

        if (btnAddFields && fieldBrowserModal) {
            btnAddFields.addEventListener('click', () => {
                console.log('🔍 Opening field browser modal');
                fieldBrowserModal.classList.remove('hidden');
            });
        }

        if (btnCloseFieldBrowser && fieldBrowserModal) {
            btnCloseFieldBrowser.addEventListener('click', () => {
                fieldBrowserModal.classList.add('hidden');
            });

            // Close on backdrop click
            fieldBrowserModal.querySelector('.rb-modal-backdrop')?.addEventListener('click', () => {
                fieldBrowserModal.classList.add('hidden');
            });
        }

        // Pivot tab handling
        const pivotTab = document.querySelector('[data-tab="pivot"]');
        if (pivotTab) {
            pivotTab.addEventListener('click', function() {
                console.log('📊 Pivot tab clicked');
                const hasFields = ReportBuilder && ReportBuilder.state && ReportBuilder.state.fields.length > 0;
                if (hasFields) {
                    setTimeout(() => {
                        if (typeof ReportBuilder.loadPivot === 'function') {
                            console.log('🔄 Auto-loading pivot...');
                            ReportBuilder.loadPivot();
                        }
                    }, 100);
                }
            });
        }

        // Refresh preview button (Configure tab)
        const btnRefreshPreview = document.getElementById('btnRefreshPreview');
        if (btnRefreshPreview) {
            btnRefreshPreview.addEventListener('click', () => {
                console.log('🔄 Manual preview refresh (Configure tab)');
                if (typeof ReportBuilder.preview === 'function') {
                    ReportBuilder.preview();
                }
            });
        }

        // Refresh pivot button
        const btnRefreshPivot = document.getElementById('btnRefreshPivot');
        if (btnRefreshPivot) {
            btnRefreshPivot.addEventListener('click', () => {
                console.log('🔄 Manual pivot refresh');
                if (typeof ReportBuilder.loadPivot === 'function') {
                    ReportBuilder.loadPivot();
                }
            });
        }

        // Export pivot button
        const btnExportPivot = document.getElementById('btnExportPivot');
        if (btnExportPivot) {
            btnExportPivot.addEventListener('click', () => {
                console.log('📤 Exporting pivot');
                if (window.pivotGridInstance) {
                    window.pivotGridInstance.exportTo('excel');
                }
            });
        }

        document.querySelectorAll('.js-local-time').forEach(timeElement => {
            const value = new Date(timeElement.dateTime);
            if (!Number.isNaN(value.getTime())) {
                timeElement.textContent = value.toLocaleString([], {
                    dateStyle: 'medium',
                    timeStyle: 'short'
                });
                timeElement.title = value.toLocaleString([], {
                    dateStyle: 'full',
                    timeStyle: 'long'
                });
            }
        });

        console.log('✅ DOM event listeners attached');
    });
</script>

</body>
</html>
