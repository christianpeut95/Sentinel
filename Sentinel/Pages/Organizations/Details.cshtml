@page
@model Sentinel.Pages.Organizations.DetailsModel

@{
    ViewData["Title"] = "Organization Details";
    Layout = "~/Pages/Shared/_LayoutSentinel.cshtml";
}

<style>
    /* Organization Details - Sentinel UI */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }

    .page-title {
        font-size: 28px;
        font-weight: 500;
        letter-spacing: -.03em;
        color: var(--forest);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .page-title i {
        color: var(--signal-dk);
    }

    /* Sentinel Buttons */
    .sn-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 36px;
        padding: 0 16px;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: -.005em;
        border: 1px solid transparent;
        border-radius: 6px;
        transition: all .12s;
        text-decoration: none;
    }

    .sn-btn--signal {
        background: var(--signal-dk);
        color: white;
    }

    .sn-btn--signal:hover {
        background: #088960;
        color: white;
    }

    .sn-btn--ghost {
        background: transparent;
        border: 1px solid var(--hairline);
        color: var(--forest);
    }

    .sn-btn--ghost:hover {
        background: var(--chalk);
        border-color: var(--slate-lt);
        color: var(--forest);
    }

    /* Cards */
    .sn-card {
        background: var(--chalk);
        border: 1px solid var(--hairline);
        border-radius: 8px;
        margin-bottom: 1rem;
        overflow: hidden;
    }

    .sn-card-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--hairline);
        background: linear-gradient(to right, var(--signal-lt), white);
    }

    .sn-card-title {
        margin: 0;
        font-size: 15px;
        font-weight: 600;
        color: var(--forest);
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sn-card-body {
        padding: 24px;
    }

    /* Field Groups */
    .sn-field-group {
        margin-bottom: 1.5rem;
    }

    .sn-field-label {
        font-family: var(--f-mono);
        font-size: 10px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--graphite);
        margin-bottom: 6px;
        display: block;
    }

    .sn-field-value {
        font-size: 15px;
        color: var(--forest);
        line-height: 1.5;
    }

    .sn-field-value-large {
        font-size: 20px;
        font-weight: 500;
        letter-spacing: -.02em;
    }

    /* Status Chips */
    .sn-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 12px;
        border-radius: 4px;
        font-family: var(--f-mono);
        font-size: 11px;
        font-weight: 500;
        letter-spacing: .04em;
        border: 1px solid transparent;
    }

    .sn-chip .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
    }

    .sn-chip.clear {
        background: var(--signal-lt);
        color: #0A3F2C;
        border-color: #9BE8C6;
    }

    .sn-chip.clear .dot {
        background: var(--signal-dk);
    }

    .sn-chip.inactive {
        background: var(--paper);
        color: var(--graphite);
        border-color: var(--hairline);
    }

    .sn-chip.inactive .dot {
        background: var(--slate);
    }

    .sn-chip.info {
        background: #E3E9FB;
        color: #2A3970;
        border-color: #B7C4EE;
    }

    .sn-chip.info .dot {
        background: var(--info);
    }

    /* Section Divider */
    .sn-divider {
        height: 1px;
        background: var(--hairline);
        margin: 1.5rem 0;
    }

    .sn-section-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--forest);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .sn-section-title i {
        color: var(--signal-dk);
    }

    /* Notes Display */
    .sn-notes {
        background: var(--signal-lt);
        border: 1px solid #9BE8C6;
        border-radius: 6px;
        padding: 16px;
        font-size: 14px;
        line-height: 1.6;
        color: var(--forest);
    }

    /* Links */
    .sn-link {
        color: var(--signal-dk);
        text-decoration: none;
        transition: color .12s;
    }

    .sn-link:hover {
        color: #088960;
        text-decoration: underline;
    }
</style>

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Organizations</a></li>
        <li class="breadcrumb-item active" aria-current="page">Details</li>
    </ol>
</nav>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-left: 3px solid var(--signal-dk);">
        <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-left: 3px solid var(--outbreak);">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-header">
    <div class="page-title">
        <i class="bi bi-building"></i>
        Organization Details
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Organization.Id" class="sn-btn sn-btn--signal">
            <i class="bi bi-pencil"></i>Edit
        </a>
        <a asp-page="./Index" class="sn-btn sn-btn--ghost">
            <i class="bi bi-arrow-left"></i>Back to List
        </a>
    </div>
</div>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-8">
            <div class="sn-card">
                <div class="sn-card-header">
                    <div class="sn-card-title">
                        <i class="bi bi-info-circle"></i>Organization Information
                    </div>
                </div>
                <div class="sn-card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Organization ID</label>
                                <div class="sn-field-value">
                                    <span class="sn-chip info">
                                        <span class="dot"></span>
                                        @Model.Organization.FriendlyId
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Status</label>
                                <div class="sn-field-value">
                                    @if (Model.Organization.IsActive)
                                    {
                                        <span class="sn-chip clear">
                                            <span class="dot"></span>
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="sn-chip inactive">
                                            <span class="dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Organization Name</label>
                                <div class="sn-field-value sn-field-value-large">@Model.Organization.Name</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Organization Type</label>
                                <div class="sn-field-value">
                                    @if (Model.Organization.OrganizationType != null)
                                    {
                                        <span class="sn-chip info">
                                            <span class="dot"></span>
                                            @Model.Organization.OrganizationType.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--graphite);">Not specified</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Export Code</label>
                                <div class="sn-field-value">@(Model.Organization.ExportCode ?? "-")</div>
                            </div>
                        </div>
                    </div>

                    <div class="sn-divider"></div>

                    <div class="sn-section-title">
                        <i class="bi bi-geo-alt"></i>Address
                    </div>
                    <div class="sn-field-group">
                        @if (!string.IsNullOrEmpty(Model.Organization.Address))
                        {
                            <div class="sn-field-value">@Model.Organization.Address</div>
                        }
                        else
                        {
                            <div class="sn-field-value" style="color: var(--graphite);">No address on file</div>
                        }
                    </div>

                    <div class="sn-divider"></div>

                    <div class="sn-section-title">
                        <i class="bi bi-telephone"></i>Contact Information
                    </div>
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Contact Person</label>
                                <div class="sn-field-value">@(Model.Organization.ContactPerson ?? "-")</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Phone</label>
                                <div class="sn-field-value">
                                    @if (!string.IsNullOrEmpty(Model.Organization.Phone))
                                    {
                                        <a href="tel:@Model.Organization.Phone" class="sn-link">@Model.Organization.Phone</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div class="sn-field-group">
                                <label class="sn-field-label">Email</label>
                                <div class="sn-field-value">
                                    @if (!string.IsNullOrEmpty(Model.Organization.Email))
                                    {
                                        <a href="mailto:@Model.Organization.Email" class="sn-link">@Model.Organization.Email</a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Organization.Notes))
                    {
                        <div class="sn-divider"></div>
                        <div class="sn-section-title">
                            <i class="bi bi-file-text"></i>Notes
                        </div>
                        <div class="sn-notes">
                            @Model.Organization.Notes
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="sn-card">
                <div class="sn-card-header">
                    <div class="sn-card-title">
                        <i class="bi bi-clock-history"></i>Audit Information
                    </div>
                </div>
                <div class="sn-card-body">
                    <div class="sn-field-group">
                        <label class="sn-field-label">Created</label>
                        <div class="sn-field-value">@Model.Organization.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                    @if (Model.Organization.ModifiedAt.HasValue)
                    {
                        <div class="sn-field-group">
                            <label class="sn-field-label">Last Modified</label>
                            <div class="sn-field-value">@Model.Organization.ModifiedAt.Value.ToString("dd MMM yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
