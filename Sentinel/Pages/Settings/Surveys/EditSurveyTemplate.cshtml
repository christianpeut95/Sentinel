@page
@model Sentinel.Pages.Settings.Surveys.EditSurveyTemplateModel
@using Sentinel.Models

@{
    ViewData["Title"] = "Edit Survey - " + Model.SurveyTemplate.Name;
    ViewData["Subtitle"] = "Survey Configuration and Versioning";
    Layout = "~/Pages/Shared/_LayoutSentinel.cshtml";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-page="./SurveyTemplates">Survey Templates</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.SurveyTemplate.Name</li>
    </ol>
</nav>

<div class="container-fluid">
    <!-- Header with Version Context -->
    <div class="card mb-4" style="border-left: 4px solid var(--signal-dk);">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h2 class="mb-2">
                        <i class="bi bi-clipboard-data me-2"></i>@Model.SurveyTemplate.Name
                    </h2>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <!-- Version Info -->
                        <span class="badge bg-success" style="font-size: 0.95rem;">
                            <i class="bi bi-tag me-1"></i>Version @Model.SurveyTemplate.VersionNumber
                        </span>
                        
                        <!-- Version Status -->
                        @switch (Model.SurveyTemplate.VersionStatus)
                        {
                            case SurveyVersionStatus.Draft:
                                <span class="badge bg-secondary" style="font-size: 0.95rem;">
                                    <i class="bi bi-file-earmark me-1"></i>Draft
                                </span>
                                break;
                            case SurveyVersionStatus.Active:
                                <span class="badge bg-success" style="font-size: 0.95rem;">
                                    <i class="bi bi-check-circle me-1"></i>Active Version
                                </span>
                                break;
                            case SurveyVersionStatus.Archived:
                                <span class="badge bg-warning text-dark" style="font-size: 0.95rem;">
                                    <i class="bi bi-archive me-1"></i>Archived
                                </span>
                                break;
                        }
                        
                        <!-- Active/Inactive -->
                        @if (Model.SurveyTemplate.IsActive)
                        {
                            <span class="badge bg-success" style="font-size: 0.95rem;">
                                <i class="bi bi-toggle-on me-1"></i>Enabled
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary" style="font-size: 0.95rem;">
                                <i class="bi bi-toggle-off me-1"></i>Disabled
                            </span>
                        }
                        
                        <!-- Usage Count -->
                        @if (Model.TaskTemplateUsageCount > 0)
                        {
                            <span class="badge bg-warning text-dark" style="font-size: 0.95rem;">
                                <i class="bi bi-diagram-3 me-1"></i>Used by @Model.TaskTemplateUsageCount task(s)
                            </span>
                        }
                        
                        <!-- Versions Count -->
                        @if (Model.AllVersions.Count > 1)
                        {
                            <span class="badge bg-success" style="font-size: 0.95rem;">
                                <i class="bi bi-layers me-1"></i>@Model.AllVersions.Count versions
                            </span>
                        }
                    </div>
                </div>
                
                <!-- Quick Actions -->
                <div class="col-md-4 text-end">
                    <a asp-page="./DesignSurvey" asp-route-id="@Model.SurveyTemplate.Id" 
                       class="btn btn-primary btn-lg">
                        <i class="bi bi-pencil-square me-1"></i>Design Survey
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts -->
    @if (Model.SurveyTemplate.IsSystemTemplate)
    {
        <div class="alert alert-danger">
            <i class="bi bi-shield-lock me-2"></i>
            <strong>System Template:</strong> This is a protected system template and cannot be edited.
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="SurveyTemplate.Id" />
        
        <div class="row">
            <!-- Left Column - Survey Info -->
            <div class="col-lg-8">
                <!-- Basic Information -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-info-circle me-2"></i>Survey Information
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label asp-for="SurveyTemplate.Name" class="form-label fw-bold"></label>
                                <input asp-for="SurveyTemplate.Name" class="form-control form-control-lg" />
                                <span asp-validation-for="SurveyTemplate.Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="SurveyTemplate.Category" class="form-label fw-bold"></label>
                                <select asp-for="SurveyTemplate.Category" class="form-select">
                                    <option value="">-- Select --</option>
                                    <option value="Foodborne">Foodborne</option>
                                    <option value="Respiratory">Respiratory</option>
                                    <option value="Vector-borne">Vector-borne</option>
                                    <option value="Contact Investigation">Contact Investigation</option>
                                    <option value="Risk Assessment">Risk Assessment</option>
                                    <option value="Symptom Screening">Symptom Screening</option>
                                    <option value="Exposure History">Exposure History</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SurveyTemplate.Description" class="form-label fw-bold"></label>
                            <textarea asp-for="SurveyTemplate.Description" class="form-control" rows="3" 
                                      placeholder="Brief description of what this survey collects..."></textarea>
                            <span asp-validation-for="SurveyTemplate.Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SurveyTemplate.Tags" class="form-label fw-bold"></label>
                            <input asp-for="SurveyTemplate.Tags" class="form-control" 
                                   placeholder="food, history, investigation (comma-separated)" />
                            <small class="form-text text-muted">
                                Tags help organize and search for surveys
                            </small>
                        </div>

                        <div class="form-check form-switch">
                            <input asp-for="SurveyTemplate.IsActive" class="form-check-input" type="checkbox" 
                                   role="switch" id="isActiveSwitch" />
                            <label class="form-check-label" for="isActiveSwitch">
                                <strong>Active</strong> - Available for use in tasks
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Applicable Diseases -->
                <div class="card mb-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-clipboard2-pulse me-2"></i>Applicable Diseases
                        </h5>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            Select diseases this survey applies to (optional, for organization)
                        </p>
                        <div class="border rounded p-3" style="max-height: 250px; overflow-y: auto;">
                            @foreach (var disease in Model.Diseases)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="SelectedDiseaseIds" 
                                           value="@disease.Value" id="disease-@disease.Value"
                                           @(Model.SelectedDiseaseIds.Contains(Guid.Parse(disease.Value)) ? "checked" : "") />
                                    <label class="form-check-label" for="disease-@disease.Value">
                                        @disease.Text
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Save Buttons -->
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-page="./SurveyTemplates" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to List
                            </a>
                            <div>
                                <a asp-page="./SurveyTemplateDetails" asp-route-id="@Model.SurveyTemplate.Id" 
                                   class="btn btn-outline-info me-2">
                                    <i class="bi bi-clock-history me-1"></i>View Version History
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save me-1"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column - Version History & Info -->
            <div class="col-lg-4">
                <!-- Version Actions -->
                @if (!Model.SurveyTemplate.IsSystemTemplate)
                {
                    <div class="card mb-4" style="border-left: 4px solid var(--signal-dk);">
                        <div class="card-header" style="background: linear-gradient(135deg, var(--signal-dk) 0%, var(--moss) 100%); color: white;">
                            <h6 class="mb-0">
                                <i class="bi bi-lightning me-2"></i>Version Actions
                            </h6>
                        </div>
                        <div class="card-body">
                            @if (Model.SurveyTemplate.VersionStatus != SurveyVersionStatus.Active)
                            {
                                <form method="post" asp-page-handler="PublishAsActive" asp-route-id="@Model.SurveyTemplate.Id">
                                    <button type="submit" class="btn btn-success w-100 mb-2"
                                            onclick="return confirm('Publish this version as active? The current active version will be archived.');">
                                        <i class="bi bi-rocket-takeoff me-1"></i>Publish as Active
                                    </button>
                                </form>
                                <small class="text-muted d-block mb-2">
                                    <i class="bi bi-info-circle"></i> This will make v@Model.SurveyTemplate.VersionNumber the active version
                                </small>
                            }
                            else
                            {
                                <div class="alert alert-success mb-2">
                                    <i class="bi bi-check-circle me-1"></i>
                                    <strong>This is the active version</strong>
                                </div>
                            }
                            
                            @if (Model.SurveyTemplate.VersionStatus == SurveyVersionStatus.Active)
                            {
                                <form method="post" asp-page-handler="ArchiveVersion" asp-route-id="@Model.SurveyTemplate.Id">
                                    <button type="submit" class="btn btn-outline-warning w-100 mb-2"
                                            onclick="return confirm('Archive this version? Make sure another version is active first.');">
                                        <i class="bi bi-archive me-1"></i>Archive This Version
                                    </button>
                                </form>
                            }
                            
                            <hr />
                            
                            <a asp-page="./CreateSurveyTemplate" 
                               asp-route-copyFromId="@Model.SurveyTemplate.Id"
                               class="btn btn-outline-primary w-100">
                                <i class="bi bi-plus-circle me-1"></i>Create New Version
                            </a>
                            <small class="text-muted d-block mt-2">
                                <i class="bi bi-info-circle"></i> Copy this version and make changes
                            </small>
                        </div>
                    </div>
                }
                
                <!-- Quick Tips -->
                <div class="card mb-4" style="border-left: 4px solid var(--signal-dk);">
                    <div class="card-header" style="background: linear-gradient(135deg, var(--signal-dk) 0%, var(--moss) 100%); color: white;">
                        <h6 class="mb-0">
                            <i class="bi bi-lightbulb me-2"></i>Quick Guide
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="mb-0 ps-3">
                            <li class="mb-2">
                                <strong>Design Survey:</strong> Click the big button to edit questions
                            </li>
                            <li class="mb-2">
                                <strong>This Page:</strong> Edit name, category, and diseases
                            </li>
                            <li class="mb-2">
                                <strong>Publish:</strong> Make any version active without recreating
                            </li>
                            <li class="mb-2">
                                <strong>Versions:</strong> Create new versions to track changes
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Version History (Compact) -->
                @if (Model.AllVersions.Any())
                {
                    <div class="card">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">
                                <i class="bi bi-clock-history me-2"></i>Version History
                                <span class="badge bg-primary float-end">@Model.AllVersions.Count</span>
                            </h6>
                        </div>
                        <div class="card-body p-0">
                            <div class="list-group list-group-flush" style="max-height: 400px; overflow-y: auto;">
                                @foreach (var version in Model.AllVersions.Take(5))
                                {
                                    <div class="list-group-item @(version.Id == Model.SurveyTemplate.Id ? "active" : "")">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <strong>v@(version.VersionNumber)</strong>
                                            @if (version.Id == Model.SurveyTemplate.Id)
                                            {
                                                <span class="badge bg-light text-dark">Current</span>
                                            }
                                        </div>
                                        <div class="mb-1">
                                            @switch (version.VersionStatus)
                                            {
                                                case SurveyVersionStatus.Draft:
                                                    <span class="badge bg-secondary">Draft</span>
                                                    break;
                                                case SurveyVersionStatus.Active:
                                                    <span class="badge bg-success">Active</span>
                                                    break;
                                                case SurveyVersionStatus.Archived:
                                                    <span class="badge bg-warning text-dark">Archived</span>
                                                    break;
                                            }
                                        </div>
                                        <small class="text-muted d-block">
                                            @ApplicationTimeZone.Format(version.CreatedAt, "d")
                                        </small>
                                        @if (!string.IsNullOrEmpty(version.VersionNotes))
                                        {
                                            <small class="text-muted d-block mt-1">
                                                @version.VersionNotes
                                            </small>
                                        }
                                    </div>
                                }
                                @if (Model.AllVersions.Count > 5)
                                {
                                    <div class="list-group-item text-center">
                                        <a asp-page="./SurveyTemplateDetails" asp-route-id="@Model.SurveyTemplate.Id" 
                                           class="text-decoration-none">
                                            View all @Model.AllVersions.Count versions ?
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
