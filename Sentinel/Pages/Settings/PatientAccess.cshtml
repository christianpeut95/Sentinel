@page
@model Sentinel.Pages.Settings.PatientAccessModel

@{
    ViewData["Title"] = "Patient Access Scope";
    ViewData["Subtitle"] = "Control how disease access affects patient visibility";
    Layout = "~/Pages/Shared/_LayoutSentinel.cshtml";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
        <li class="breadcrumb-item active" aria-current="page">Patient Access Scope</li>
    </ol>
</nav>

<div class="row">
    <div class="col-lg-8">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h4 class="mb-1"><i class="bi bi-person-lock me-2"></i>Patient Access Scope</h4>
                <p class="text-muted mb-0">Set the installation-wide patient visibility policy.</p>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="CaseScopedPatientAccess" class="form-check-input" role="switch" style="width: 3em; height: 1.5em;" />
                        <label asp-for="CaseScopedPatientAccess" class="form-check-label ms-2 fw-semibold"></label>
                    </div>

                    <p class="text-muted mb-4">
                        When enabled, a user with patient permissions can only find or open a patient if the patient has at least one case for a disease the user is allowed to access. Case access remains controlled separately by case permissions.
                    </p>

                    <div class="alert alert-info mb-4">
                        <h6><i class="bi bi-info-circle me-1"></i>When disabled (default)</h6>
                        <p class="mb-0">Users with patient view or search permissions can see all patients, while case details remain protected by their own permissions and disease-access rules.</p>
                    </div>

                    <div class="alert alert-warning mb-4">
                        <h6><i class="bi bi-shield-lock me-1"></i>When enabled</h6>
                        <p class="mb-0">Patient lists, searches, and direct patient pages follow the same hierarchy-aware disease access boundary used for cases. A public child disease does not expose a patient when one of its ancestors is restricted.</p>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save Access Scope
                    </button>
                    <a asp-page="/Settings/Index" class="btn btn-outline-secondary ms-2">Back to Settings</a>
                </form>
            </div>
        </div>
    </div>
</div>
