@page "{diseaseId:guid?}"
@model Sentinel.Pages.Settings.Diseases.ReinfectionRulesModel

@{
    ViewData["Title"] = "Reinfection Windows";
    Layout = "~/Pages/Shared/_LayoutSentinel.cshtml";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Diseases</a></li>
        <li class="breadcrumb-item active" aria-current="page">Reinfection Windows</li>
    </ol>
</nav>

<div class="sentinel-page-header mb-4">
    <div>
        <div class="sentinel-eyebrow">Disease Configuration</div>
        <h1 class="sentinel-page-title">Reinfection Windows</h1>
        <p class="sentinel-page-subtitle">Configure time windows for case reinfection detection</p>
    </div>
</div>

<!-- Disease Filter -->
<div class="sentinel-card mb-4">
    <div class="sentinel-card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-6">
                <label for="diseaseFilter" class="sn-label">Filter by Disease</label>
                <select name="diseaseId" id="diseaseFilter" class="sn-input" onchange="this.form.submit()">
                    <option value="">-- All Diseases --</option>
                    @foreach (var disease in Model.AllDiseases)
                    {
                        <option value="@disease.Id" selected="@(disease.Id == Model.SelectedDiseaseId)">
                            @disease.Name
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <a asp-page="./ReinfectionRulesEdit" asp-route-diseaseId="@Model.SelectedDiseaseId" 
                   class="sn-btn sn-btn--signal">
                    <i class="bi bi-plus-circle me-1"></i>Add Reinfection Window
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Info Alert -->
<div class="alert alert-info mb-4" role="alert">
    <h5 style="font-weight:600;margin-bottom:8px">
        <i class="bi bi-info-circle me-2"></i>About Reinfection Windows
    </h5>
    <p style="margin-bottom:0">
        Configure the number of days that must pass before a new lab result creates a new case for the same patient and disease. 
        If a positive result arrives within the window, it will be added to the existing case.
    </p>
</div>

@if (Model.Rules.Any())
{
    <div class="sentinel-card">
        <div class="sentinel-card-body" style="padding:0">
            <div class="sn-table-container">
                <table class="sn-table">
                    <thead>
                        <tr>
                            <th>Disease</th>
                            <th>Reinfection Window</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rule in Model.Rules)
                        {
                            <tr>
                                <td>
                                    <strong>@rule.Disease?.Name</strong>
                                </td>
                                <td>
                                    @if (rule.ReinfectionWindowDays.HasValue)
                                    {
                                        <span style="font-family:var(--f-mono);color:var(--graphite);font-size:15px;font-weight:600">
                                            @rule.ReinfectionWindowDays.Value days
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--graphite-lt)">—</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(rule.Description))
                                    {
                                        <span style="font-size:13px;color:var(--graphite)">
                                            @(rule.Description.Length > 60 ? rule.Description.Substring(0, 60) + "..." : rule.Description)
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--graphite-lt)">—</span>
                                    }
                                </td>
                                <td>
                                    @if (rule.IsActive)
                                    {
                                        <span class="chip chip--clear">Active</span>
                                    }
                                    else
                                    {
                                        <span class="chip">Inactive</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-page="./ReinfectionRulesEdit" asp-route-id="@rule.Id" 
                                       class="sn-btn sn-btn--ghost" style="padding:6px 12px">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="sn-btn sn-btn--ghost" 
                                            style="padding:6px 12px"
                                            data-bs-toggle="modal" 
                                            data-bs-target="#deleteModal-@rule.Id">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Delete Modals -->
    @foreach (var rule in Model.Rules)
    {
        <div class="modal fade" id="deleteModal-@rule.Id" tabindex="-1" aria-labelledby="deleteModalLabel-@rule.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel-@rule.Id">Confirm Delete</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p>Are you sure you want to delete the reinfection window for <strong>@rule.Disease?.Name</strong>?</p>
                        <p class="text-danger">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Warning:</strong> This will affect how future lab results create cases for this disease.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="sn-btn sn-btn--ghost" data-bs-dismiss="modal">Cancel</button>
                        <form method="post" asp-page-handler="Delete" style="display:inline">
                            <input type="hidden" name="id" value="@rule.Id" />
                            <input type="hidden" name="diseaseId" value="@Model.SelectedDiseaseId" />
                            <button type="submit" class="sn-btn sn-btn--ghost" style="color:var(--outbreak)">
                                <i class="bi bi-trash me-1"></i>Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="sentinel-card">
        <div class="sentinel-card-body text-center" style="padding:60px 20px">
            <i class="bi bi-clipboard-data" style="font-size:48px;color:var(--graphite-lt);margin-bottom:16px"></i>
            <h5 style="color:var(--graphite);margin-bottom:8px">No Reinfection Windows</h5>
            <p style="color:var(--graphite);margin-bottom:24px">
                @if (Model.SelectedDiseaseId.HasValue)
                {
                    <text>No reinfection window found for the selected disease.</text>
                }
                else
                {
                    <text>No reinfection windows have been configured yet.</text>
                }
            </p>
            <a asp-page="./ReinfectionRulesEdit" asp-route-diseaseId="@Model.SelectedDiseaseId" 
               class="sn-btn sn-btn--signal">
                <i class="bi bi-plus-circle me-1"></i>Add First Window
            </a>
        </div>
    </div>
}
