@page "{id:guid}"
@model Sentinel.Pages.Settings.DiseaseCategories.EditModel
@{
    ViewData["Title"] = "Edit Disease Category";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Disease Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>

<h2><i class="bi bi-pencil me-2"></i>Edit Disease Category</h2>
<hr />

<div class="row">
    <div class="col-md-7 col-lg-6">
        <form method="post" asp-route-id="@RouteData.Values["id"]">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>
                <input asp-for="Input.Name" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ReportingId" class="form-label"></label>
                <input asp-for="Input.ReportingId" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.ReportingId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label"></label>
                <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.DisplayOrder" class="form-label"></label>
                <input asp-for="Input.DisplayOrder" class="form-control" type="number" min="0" max="10000" />
                <span asp-validation-for="Input.DisplayOrder" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save changes</button>
            <a asp-page="./Details" asp-route-id="@RouteData.Values["id"]" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
