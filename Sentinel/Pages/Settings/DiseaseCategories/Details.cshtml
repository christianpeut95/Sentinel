@page "{id:guid}"
@model Sentinel.Pages.Settings.DiseaseCategories.DetailsModel
@{
    ViewData["Title"] = "Disease Category";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-page="/Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-page="/Settings/Index">Settings</a></li>
        <li class="breadcrumb-item"><a asp-page="./Index">Disease Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Category.Name</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-folder2-open me-2"></i>@Model.Category.Name</h2>
        <p class="text-muted mb-0">Disease category configuration</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-page="./Edit" asp-route-id="@Model.Category.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to categories</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Reporting ID</dt>
            <dd class="col-sm-9"><code>@Model.Category.ReportingId</code></dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@(Model.Category.Description ?? "-")</dd>

            <dt class="col-sm-3">Display order</dt>
            <dd class="col-sm-9">@Model.Category.DisplayOrder</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.Category.IsActive)
                {
                    <span class="badge text-bg-success">Active</span>
                }
                else
                {
                    <span class="badge text-bg-secondary">Inactive</span>
                }
            </dd>

            <dt class="col-sm-3">Diseases assigned</dt>
            <dd class="col-sm-9">@Model.DiseaseCount</dd>
        </dl>
    </div>
</div>
